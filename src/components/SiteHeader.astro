---
// src/components/SiteHeader.astro
import Menu from './Menu.astro';

const pathname = Astro.url.pathname;
const currentPath = pathname === '/' ? '/' : pathname.replace(/\/$/, '');

const getNavLinkClass = (path: string) => {
  const baseClass = "text-white text-base transition-all duration-300";
  return currentPath === path 
    ? `${baseClass} font-black border-b-[3px] border-white pb-1` 
    : `${baseClass} font-medium opacity-80 hover:opacity-100`;  
};
---

<div class="h-24 md:h-28 w-full flex-shrink-0 pointer-events-none"></div>

<div id="main-header" class="fixed top-2 md:top-3 left-0 w-full px-2 lg:px-8 z-30 pointer-events-none flex justify-center flex-col items-center transition-all duration-500 ease-in-out">
  
  <header class="w-full max-w-[calc(1300px+2rem)] lg:max-w-[calc(1300px+4rem)] bg-[#8C17F8] border border-white/20 rounded-full h-20 px-4 lg:px-8 flex items-center pointer-events-auto transition-all duration-300 shadow-sm">
    
    <div class="max-w-[1300px] mx-auto w-full flex justify-between items-center">
      
      <a href="/" class="group flex items-center transition-transform duration-300 hover:scale-105">
        <img src="/Icone_Opensigne_blanc.svg" alt="Logo Opensigne" class="h-12 md:h-16 w-auto" />
      </a>
      
      <div class="flex items-center gap-3 md:gap-5">
        
        <nav class="hidden lg:flex items-center gap-6 xl:gap-8 mr-2">
          <a href="/" class={getNavLinkClass('/')}>Accueil</a>
          <a href="/jeux" class={getNavLinkClass('/jeux')}>Jeux</a>
          <a href="/bibliotheque" class={getNavLinkClass('/bibliotheque')}>Dictionnaire</a>
          <a href="/classement" class={getNavLinkClass('/classement')}>Stats</a>
        </nav>

        {/* --- ZONE VISITEUR (Non connecté) --- */}
        <div id="guest-zone" class="flex items-center gap-2 md:gap-4 mr-1 md:mr-2">
          <a 
            href="/login-mail" 
            class="hidden sm:block border-2 border-white text-white font-bold text-sm px-4 py-2 rounded-full transition-all duration-300 hover:bg-white/10 active:scale-95"
          >
            Se connecter
          </a>
          <a 
            href="/register" 
            class="bg-white text-[#8C17F8] font-bold text-sm md:text-base px-5 py-2.5 rounded-full shadow-[0_4px_12px_rgba(0,0,0,0.1)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_8px_20px_rgba(0,0,0,0.15)] active:scale-95"
          >
            Créer un compte
          </a>
        </div>

        {/* --- ZONE UTILISATEUR (Connecté) --- */}
        <a 
          id="logged-zone" 
          href="/profil" 
          class="hidden items-center gap-3 bg-white/20 border border-white/30 px-4 py-1.5 rounded-full transition-all hover:bg-white/30 active:scale-95 group mr-1 md:mr-2 backdrop-blur-sm"
        >
          <span id="header-user-name" class="text-white font-bold text-sm md:text-base tracking-wide">Profil</span>
          <div class="w-8 h-8 rounded-full bg-white/30 flex items-center justify-center overflow-hidden">
            <img id="header-avatar-img" src="" class="w-full h-full object-cover hidden" />
            <svg id="header-avatar-svg" class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" />
            </svg>
          </div>
        </a>

        <button id="menu-btn" aria-label="Ouvrir le menu" class="relative w-12 h-12 pointer-events-auto group cursor-pointer outline-none flex justify-center items-center">
          <div class="relative w-8 h-8 flex flex-col justify-center items-end">
            <span class="line-1 absolute h-[3px] w-8 bg-white rounded-full transition-all duration-300 ease-in-out -translate-y-[10px] group-hover:bg-white/90"></span>
            <span class="line-2 absolute h-[3px] w-5 bg-white rounded-full transition-all duration-300 ease-in-out right-0 group-hover:w-8 group-hover:bg-white/90"></span>
            <span class="line-3 absolute h-[3px] w-8 bg-white rounded-full transition-all duration-300 ease-in-out translate-y-[10px] group-hover:bg-white/90"></span>
          </div>
        </button>

      </div>
    </div>
  </header>

</div>

<Menu />

<style>
  :global(body.menu-open) #main-header { 
    transform: translateY(-150%); 
    opacity: 0; 
    pointer-events: none;
  }
</style>

<script>
  import { pb } from '../lib/pb.js';

  const initHeader = async () => {
    const guestZone = document.getElementById('guest-zone');
    const loggedZone = document.getElementById('logged-zone');
    const nameElement = document.getElementById('header-user-name');
    const avatarImg = document.getElementById('header-avatar-img') as HTMLImageElement;
    const avatarSvg = document.getElementById('header-avatar-svg');

    if (pb.authStore.isValid && pb.authStore.model) {
      const user = pb.authStore.model;

      if (guestZone) {
        guestZone.classList.add('hidden');
        guestZone.classList.remove('flex');
      }
      if (loggedZone) {
        loggedZone.classList.remove('hidden');
        loggedZone.classList.add('flex');
      }

      const displayName = user.first_name || user.username || user.name || 'Profil';
      if (nameElement) nameElement.textContent = displayName;

      if (user.avatar && avatarImg && avatarSvg) {
        avatarImg.src = pb.files.getUrl(user, user.avatar);
        avatarImg.classList.remove('hidden');
        avatarSvg.classList.add('hidden');
      }
    } else {
      if (guestZone) {
        guestZone.classList.remove('hidden');
        guestZone.classList.add('flex');
      }
      if (loggedZone) {
        loggedZone.classList.add('hidden');
        loggedZone.classList.remove('flex');
      }
    }
  };

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>