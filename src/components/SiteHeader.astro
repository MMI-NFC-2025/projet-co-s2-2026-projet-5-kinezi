---
// src/components/SiteHeader.astro
import Menu from './Menu.astro';

// 1. Récupération de l'URL actuelle pour savoir sur quelle page on est
const pathname = Astro.url.pathname;
const currentPath = pathname === '/' ? '/' : pathname.replace(/\/$/, '');

// 2. Fonction pour donner un style différent au lien actif
const getNavLinkClass = (path: string) => {
  const baseClass = "text-white text-base transition-all duration-300";
  return currentPath === path 
    ? `${baseClass} font-black border-b-[3px] border-white pb-1` // Style Actif (Gras + Souligné)
    : `${baseClass} font-medium opacity-80 hover:opacity-100`;   // Style Inactif (Un peu transparent)
};
---

<div id="main-header" class="fixed top-2 md:top-3 left-0 w-full px-2 lg:px-8 z-[90] pointer-events-none flex justify-center flex-col items-center transition-all duration-500 ease-in-out">
  
  <header class="w-full max-w-[calc(1300px+2rem)] lg:max-w-[calc(1300px+4rem)] bg-[#8C17F8]/90 backdrop-blur-md shadow-[0_10px_30px_rgba(168,152,238,0.3)] border border-white/30 rounded-full h-20 px-4 lg:px-8 flex items-center pointer-events-auto transition-all duration-300">
    
    <div class="max-w-[1300px] mx-auto w-full flex justify-between items-center">
      
      <a href="/" class="group flex items-center transition-transform duration-300 hover:scale-105">
        <img src="/logo-kinezi-K.svg" alt="Logo Kinezi" class="h-10 md:h-12 w-auto brightness-0 invert" />
      </a>
      
      <div class="flex items-center gap-3 md:gap-5">
        
        <nav class="hidden lg:flex items-center gap-6 xl:gap-8 mr-2">
          <a href="/" class={getNavLinkClass('/')}>Accueil</a>
          <a href="/jeux" class={getNavLinkClass('/jeux')}>Jeux</a>
          <a href="/dictionnaire" class={getNavLinkClass('/dictionnaire')}>Dictionnaire</a>
          <a href="/classement" class={getNavLinkClass('/classement')}>Stats</a>
        </nav>

        <div id="header-user-badge" class="hidden items-center gap-3 bg-black/10 hover:bg-black/20 transition-colors rounded-full py-1.5 pl-4 pr-1.5 backdrop-blur-sm border border-white/10 mr-1 md:mr-2 cursor-pointer">
          <span id="header-user-name" class="text-white font-bold text-sm tracking-wide">...</span>
          <div class="w-8 h-8 rounded-full overflow-hidden bg-white/20 flex items-center justify-center">
            <img id="header-avatar-img" src="" alt="Avatar" class="w-full h-full object-cover hidden" />
            <svg id="header-avatar-svg" class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </div>
        </div>

        <button id="menu-btn" aria-label="Ouvrir le menu" class="relative w-12 h-12 pointer-events-auto group cursor-pointer outline-none flex justify-center items-center">
          <div class="relative w-8 h-8 flex flex-col justify-center items-end">
            <span class="line-1 absolute h-[3px] w-8 bg-white rounded-full transition-all duration-300 ease-in-out -translate-y-[10px] group-hover:bg-white/90"></span>
            <span class="line-2 absolute h-[3px] w-5 bg-white rounded-full transition-all duration-300 ease-in-out right-0 group-hover:w-8 group-hover:bg-white/90"></span>
            <span class="line-3 absolute h-[3px] w-8 bg-white rounded-full transition-all duration-300 ease-in-out translate-y-[10px] group-hover:bg-white/90"></span>
          </div>
        </button>

      </div>
    </div>
  </header>

</div>

<Menu />

<style>
  /* L'ANIMATION MAGIQUE */
  :global(body.menu-open) #main-header { 
    transform: translateY(-150%); 
    opacity: 0; 
    pointer-events: none;
  }
</style>

<script>
  import PocketBase from 'pocketbase';

  const initHeader = async () => {
    const pb = new PocketBase('http://127.0.0.1:8090');
    
    // Éléments du DOM
    const badge = document.getElementById('header-user-badge');
    const nameElement = document.getElementById('header-user-name');
    const avatarImg = document.getElementById('header-avatar-img') as HTMLImageElement;
    const avatarSvg = document.getElementById('header-avatar-svg');

    // Vérification de la connexion
    if (pb.authStore.isValid && pb.authStore.model) {
      const user = pb.authStore.model;

      // On affiche le badge (flex au lieu de hidden)
      if (badge) {
        badge.classList.remove('hidden');
        badge.classList.add('flex');
      }

      // On utilise la même logique que pour le grand menu (first_name en priorité)
      const displayName = user.first_name || user.username || user.name || 'Utilisateur';
      if (nameElement) nameElement.textContent = displayName;

      // Gestion de l'avatar
      if (user.avatar && avatarImg && avatarSvg) {
        avatarImg.src = pb.files.getUrl(user, user.avatar);
        avatarImg.classList.remove('hidden');
        avatarSvg.classList.add('hidden');
      }
    } else {
      // Si déconnecté, on cache complètement le badge
      if (badge) {
        badge.classList.add('hidden');
        badge.classList.remove('flex');
      }
    }
    
    // (Bonus) : Cliquer sur le badge ouvre aussi le menu pour accéder au profil
    if (badge) {
      badge.onclick = () => {
        const menuBtn = document.getElementById('menu-btn');
        if (menuBtn) menuBtn.click();
      }
    }
  };

  // On lance le script au chargement de la page et lors des navigations Astro
  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>