---
const pathname = Astro.url.pathname;
const currentPath = pathname === '/' ? '/' : pathname.replace(/\/$/, '');

const getLinkClass = (path: string) => {
  const baseClass = "flex items-center gap-5 py-4 px-8 w-[90%] rounded-r-full transition-all duration-300 active:scale-95 active:duration-75";
  return currentPath === path 
    ? `${baseClass} bg-white text-[#A898EE] shadow-sm hover:scale-[1.02]` 
    : `${baseClass} text-white hover:bg-white/10`;
};

const getSpanClass = (path: string) => {
  return currentPath === path ? "font-bold text-lg" : "font-medium text-lg";
};
---

<div 
  id="menu-overlay" 
  class="fixed inset-0 bg-black/40 z-[100] opacity-0 pointer-events-none transition-opacity duration-300"
></div>

<aside 
  id="side-menu" 
  class="fixed top-0 left-0 w-[85%] max-w-[350px] h-[100dvh] bg-[#A898EE] rounded-r-[40px] shadow-2xl z-[101] transform -translate-x-full transition-transform duration-300 flex flex-col py-12 overflow-y-auto no-scrollbar pointer-events-auto"
>
  
  <button id="close-menu-btn" class="absolute top-6 right-6 w-10 h-10 bg-black/10 hover:bg-black/20 rounded-full flex items-center justify-center text-white transition-colors cursor-pointer z-50">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>

  <div class="flex items-center gap-6 px-8 mb-12 mt-2">
    <div id="menu-avatar-container" class="w-20 h-20 rounded-full border-[3px] border-white flex items-center justify-center flex-shrink-0 bg-white/20 overflow-hidden">
      <img id="menu-avatar-img" src="" class="w-full h-full object-cover hidden" />
      <svg id="menu-avatar-svg" class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
      </svg>
    </div>
    <span id="menu-user-name" class="text-white font-black text-2xl tracking-tight truncate">Chargement...</span>
  </div>

  <nav class="flex-1 flex flex-col gap-2">
    <a href="/" class={getLinkClass('/')}>
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
      </svg>
      <span class={getSpanClass('/')}>Accueil</span>
    </a>

    <a href="/profil" class={getLinkClass('/profil')}>
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
      </svg>
      <span class={getSpanClass('/profil')}>Profil</span>
    </a>

   <a href="/jeux" class={getLinkClass('/jeux')}>
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
      </svg>
      <span class={getSpanClass('/jeux')}>Exercices</span>
    </a>

    <a href="/bibliotheque" class={getLinkClass('/bibliotheque')}>
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"></path>
      </svg>
      <span class={getSpanClass('/bibliotheque')}>Bibliothèque de leçons</span>
    </a>

    <a href="/favoris" class={getLinkClass('/favoris')}>
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
      </svg>
      <span class={getSpanClass('/favoris')}>Leçons préférées</span>
    </a>

    <a href="/abonnement" class={getLinkClass('/abonnement')}>
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
      </svg>
      <span class={getSpanClass('/abonnement')}>Abonnement</span>
    </a>

    <a href="/landing_page" class={getLinkClass('/landing_page')}>
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span class={getSpanClass('/landing_page')}>À propos</span>
    </a>

    <div class="h-[2px] bg-white/30 w-[70%] mx-auto my-4 rounded-full"></div>

    <a href="/parametres" class={getLinkClass('/parametres')}>
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
      </svg>
      <span class={getSpanClass('/parametres')}>Paramètres</span>
    </a>

    
    <a href="/aide" class={getLinkClass('/aide')}>
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 11h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5Zm0 0a9 9 0 1 1 18 0m0 0v5a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3Z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 16v2a4 4 0 0 1-4 4h-5"></path>
      </svg>
      <span class={getSpanClass('/aide')}>Aide</span>
    </a>

    <div class="h-[2px] bg-white/30 w-[70%] mx-auto my-4 rounded-full"></div>

    <a href="#" id="logout-btn" class={`${getLinkClass('/deconnexion')} mt-auto`}>
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
      </svg>
      <span class={getSpanClass('/deconnexion')}>Déconnexion</span>
    </a>

  </nav>
</aside>

<script>
  import { pb } from '../lib/pb.js';

  const initSideMenu = async () => {
    const nameElement = document.getElementById('menu-user-name');
    
    if (pb.authStore.isValid && pb.authStore.model) {
      const user = pb.authStore.model;
      const avatarImg = document.getElementById('menu-avatar-img') as HTMLImageElement;
      const avatarSvg = document.getElementById('menu-avatar-svg');

      const displayName = user.first_name || user.username || user.name || 'Utilisateur';
      
      if (nameElement) nameElement.textContent = displayName;

      if (user.avatar && avatarImg && avatarSvg) {
        avatarImg.src = pb.files.getUrl(user, user.avatar);
        avatarImg.classList.remove('hidden');
        avatarSvg.classList.add('hidden');
      }
    } else {
      if (nameElement) nameElement.textContent = 'Non connecté';
    }

    const logoutBtn = document.getElementById('logout-btn');
    if (logoutBtn) {
      logoutBtn.onclick = (e) => {
        e.preventDefault();
        pb.authStore.clear(); 
        window.location.href = '/'; 
      };
    }

    const menuBtn = document.getElementById('menu-btn');
    const closeBtn = document.getElementById('close-menu-btn');
    const sideMenu = document.getElementById('side-menu');
    const menuOverlay = document.getElementById('menu-overlay');

    if (!sideMenu || !menuOverlay) return;

    const toggleMenu = () => {
      const isClosed = sideMenu.classList.contains('-translate-x-full');
      if (isClosed) {
        sideMenu.classList.remove('-translate-x-full');
        menuOverlay.classList.remove('opacity-0', 'pointer-events-none');
        menuOverlay.classList.add('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = 'hidden';
      } else {
        sideMenu.classList.add('-translate-x-full');
        menuOverlay.classList.remove('opacity-100', 'pointer-events-auto');
        menuOverlay.classList.add('opacity-0', 'pointer-events-none');
        document.body.style.overflow = '';
      }
    };

    if (menuBtn) menuBtn.onclick = toggleMenu;
    if (closeBtn) closeBtn.onclick = toggleMenu;
    if (menuOverlay) menuOverlay.onclick = toggleMenu;
  };

  initSideMenu();
  document.addEventListener('astro:page-load', initSideMenu);
</script>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>