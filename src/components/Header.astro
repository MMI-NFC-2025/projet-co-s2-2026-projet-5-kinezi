---
// src/components/Header.astro
---
<div class="absolute w-full top-0 z-50 flex flex-col pointer-events-none">
  
  <header class="bg-[#A898EE] h-20 flex items-center px-6 lg:px-16 z-10 relative pointer-events-auto shadow-sm">
    <div class="max-w-[1300px] mx-auto w-full flex justify-between items-center">
      
      <a href="/" class="group flex items-center transition-transform duration-300 hover:scale-105">
        <img 
          src="/Icone_Opensigne_blanc.svg" 
          alt="Logo Opensigne" 
          class="h-12 md:h-16 w-auto"
        />
      </a>
      
      <div class="flex items-center gap-3 md:gap-5">
        
        <div id="guest-zone" class="flex items-center gap-3 md:gap-5">
          <a 
            href="/login-mail" 
            class="hidden sm:block border-2 border-white text-white font-bold text-sm px-4 py-2 rounded-full transition-all duration-300 hover:bg-white/10 active:scale-95"
          >
            Se connecter
          </a>

          <a 
            href="/register" 
            class="bg-white text-[#A898EE] font-bold text-sm md:text-base px-5 py-2.5 rounded-full shadow-[0_4px_12px_rgba(0,0,0,0.1)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_8px_20px_rgba(0,0,0,0.15)] active:scale-95"
          >
            Créer un compte
          </a>
        </div>

        <a 
          id="logged-zone" 
          href="/profil" 
          class="hidden items-center gap-3 bg-white/20 border border-white/40 px-4 py-2 rounded-full transition-all hover:bg-white/30 active:scale-95 group"
        >
          <span id="header-user-name" class="text-white font-bold text-sm md:text-base">Profil</span>
          <div class="w-8 h-8 rounded-full bg-white flex items-center justify-center overflow-hidden">
            <img id="header-avatar-img" src="" class="w-full h-full object-cover hidden" />
            <svg id="header-avatar-svg" class="w-5 h-5 text-[#A898EE]" fill="currentColor" viewBox="0 0 24 24">
              <path d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" />
            </svg>
          </div>
        </a>

        <button id="menu-btn" class="relative w-12 h-12 z-20 pointer-events-auto group cursor-pointer outline-none flex justify-center items-center -mr-2">
          <div class="relative w-8 h-8 flex flex-col justify-center items-end">
            <span class="line-1 absolute h-[3px] w-8 bg-white rounded-full transition-all duration-300 ease-in-out -translate-y-[10px] group-hover:bg-white/90"></span>
            <span class="line-2 absolute h-[3px] w-5 bg-white rounded-full transition-all duration-300 ease-in-out right-0 group-hover:w-8 group-hover:bg-white/90"></span>
            <span class="line-3 absolute h-[3px] w-8 bg-white rounded-full transition-all duration-300 ease-in-out translate-y-[10px] group-hover:bg-white/90"></span>
          </div>
        </button>

      </div>

    </div>
  </header>

  <div class="w-full leading-[0] -mt-[1px] z-0">
    <svg 
      xmlns="http://www.w3.org/2000/svg" 
      viewBox="0 0 1440 120" 
      class="w-full h-auto drop-shadow-xl overflow-visible" 
      preserveAspectRatio="none"
    >
      <path 
        fill="#8C17F8" 
        d="M0,0 L1440,0 L1440,90 C1100,150 400,-30 0,90 Z"
      ></path>

      <path 
        fill="#A898EE" 
        d="M0,0 L1440,0 L1440,40 C1100,120 400,-40 0,60 Z"
        style="filter: drop-shadow(0px 8px 12px rgba(0, 0, 0, 0.15));"
      ></path>
    </svg>
  </div>
</div>

<script>
  import { pb } from '../lib/pb.js'; 

  const updateHeaderAuth = () => {
    const guestZone = document.getElementById('guest-zone');
    const loggedZone = document.getElementById('logged-zone');
    const headerName = document.getElementById('header-user-name');
    // On précise à TypeScript que cet élément est bien une image
    const avatarImg = document.getElementById('header-avatar-img') as HTMLImageElement | null;
    const avatarSvg = document.getElementById('header-avatar-svg');
    const menuBtn = document.getElementById('menu-btn');

    if (menuBtn) {
      menuBtn.onclick = () => {
        menuBtn.classList.toggle('is-active');
      };
    }

    // On vérifie explicitement que model n'est pas null pour satisfaire TypeScript
    if (pb.authStore.isValid && pb.authStore.model) {
      const user = pb.authStore.model;

      if (guestZone) guestZone.classList.add('hidden');
      if (loggedZone) {
        loggedZone.classList.remove('hidden');
        loggedZone.classList.add('flex');
      }

      if (headerName) headerName.textContent = user.first_name || 'Profil';
      
      if (user.avatar && avatarImg && avatarSvg) {
        // user est maintenant garanti non-null, et avatarImg est reconnu comme une image
        avatarImg.src = pb.files.getUrl(user, user.avatar);
        avatarImg.classList.remove('hidden');
        avatarSvg.classList.add('hidden');
      }
    } else {
      if (guestZone) guestZone.classList.remove('hidden');
      if (loggedZone) {
        loggedZone.classList.add('hidden');
        loggedZone.classList.remove('flex');
      }
    }
  };

  updateHeaderAuth();
  document.addEventListener('astro:page-load', updateHeaderAuth);
</script>

<style>
  #menu-btn.is-active .line-1 {
    transform: translateY(0) rotate(45deg);
  }
  #menu-btn.is-active .line-2 {
    opacity: 0;
    width: 0;
  }
  #menu-btn.is-active .line-3 {
    transform: translateY(0) rotate(-45deg);
  }
</style>