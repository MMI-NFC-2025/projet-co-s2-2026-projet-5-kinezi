---
// src/components/Sidebar.astro

const pathname = Astro.url.pathname;
const currentPath = pathname === '/' ? '/' : pathname.replace(/\/$/, '');

const navItems = [
  { href: '/', icon: 'home', label: 'Accueil' },
  { href: '/bibliotheque', icon: 'book', label: 'Bibliothèque' },
  { href: '/exercices', icon: 'stats', label: 'Exercices' },
  { href: '/profil', icon: 'profile', label: 'Profil' },
];
---

<aside class="hidden md:flex fixed left-0 top-1/2 -translate-y-1/2 w-20 bg-[#8C17F8] rounded-r-[32px] flex-col items-center py-10 shadow-[10px_0_30px_rgba(140,23,248,0.2)] z-[100]">
  
  <div class="flex flex-col w-full gap-3 relative">
    {navItems.map((item) => {
      const isActive = currentPath === item.href;
      
      return (
        <a href={item.href} class="relative w-full h-[76px] flex items-center justify-center group outline-none">
          
          {/* LE CERCLE PARFAIT 
              Sans éléments parasites. right-[-36px] place son centre exactement sur la bordure.
          */}
          {isActive && (
            <div class="absolute right-[-36px] top-1/2 -translate-y-1/2 w-[72px] h-[72px] bg-[#8C17F8] rounded-full z-0 pointer-events-none transition-all duration-300 drop-shadow-[5px_0_10px_rgba(140,23,248,0.15)]"></div>
          )}
          
          {/* L'ICÔNE (Géométriquement centrée)
              translate-x-[40px] : Amène le centre de l'icône exactement au même endroit que le centre du cercle.
          */}
          <div class={`relative z-10 flex items-center justify-center transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] ${isActive ? 'translate-x-[40px] text-white scale-125' : 'text-white/60 hover:text-white hover:scale-110'}`}>
            
            {item.icon === 'home' && (
              <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
            )}
            
            {item.icon === 'book' && (
              <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            )}
            
            {item.icon === 'stats' && (
              <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 20h16 M4 16h3v4H4z M9 12h3v8H9z M14 8h3v12h-3z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 12l6-6 4 4 6-6 M17 4h3v3" />
              </svg>
            )}
            
            {item.icon === 'profile' && (
              <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <circle cx="12" cy="9" r="3" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 18a5 5 0 0110 0" />
              </svg>
            )}

          </div>
        </a>
      );
    })}
  </div>
</aside>