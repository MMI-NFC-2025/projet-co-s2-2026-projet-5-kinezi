---
// src/components/Sidebar.astro
const pathname = Astro.url.pathname;
const currentPath = pathname === '/' ? '/' : pathname.replace(/\/$/, '');

const navItems = [
  { href: '/', icon: 'home', label: 'Accueil' },
  { href: '/jeux', icon: 'zap', label: 'Exercices' },
  { href: '/bibliotheque', icon: 'book', label: 'Bibliothèque' },
  { href: '/profil', icon: 'profile', label: 'Profil' },
];
---

{/* md:hidden permet de cacher complètement cette barre sur les écrans PC */}
<aside class="md:hidden fixed bottom-0 left-0 w-full bg-[#8C17F8] rounded-t-[32px] flex items-center py-3 z-40 shadow-[0_-4px_20px_rgba(0,0,0,0.1)]">
  
  <div class="flex w-full justify-around relative">
    {navItems.map((item) => {
      const isActive = currentPath === item.href;
      
      return (
        <a href={item.href} class="relative w-12 h-12 flex items-center justify-center group outline-none" aria-label={item.label}>
          
          {/* BULLE ACTIVE */}
          {isActive && (
            <div class="absolute top-[-36px] w-[56px] h-[56px] bg-[#8C17F8] rounded-full z-0 pointer-events-none transition-all duration-300"></div>
          )}
          
          {/* L'ICÔNE AVEC ANIMATION */}
          <div class={`relative z-10 flex items-center justify-center transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)]
            ${isActive 
              ? 'text-white scale-[1.3] -translate-y-[28px] animate-float-y' 
              : 'text-white/50 group-hover:text-white group-hover:scale-110'
            }`}
          >
            {item.icon === 'home' && <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.592 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>}
            {item.icon === 'zap' && <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>}
            {item.icon === 'book' && <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" /></svg>}
            {item.icon === 'profile' && <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>}
          </div>
        </a>
      );
    })}
  </div>
</aside>

<style>
  /* Animation flottante sur Mobile */
  @keyframes float-y {
    0% { transform: translateY(-28px) translateX(0px) scale(1.3); }
    50% { transform: translateY(-31px) translateX(0px) scale(1.3); }
    100% { transform: translateY(-28px) translateX(0px) scale(1.3); }
  }
  .animate-float-y { animation: float-y 4s ease-in-out infinite; }
</style>