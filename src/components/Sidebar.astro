---
// src/components/Sidebar.astro

const pathname = Astro.url.pathname;
const currentPath = pathname === '/' ? '/' : pathname.replace(/\/$/, '');

const navItems = [
  { href: '/', icon: 'home', label: 'Accueil' },
  { href: '/bibliotheque', icon: 'book', label: 'Bibliothèque' },
  { href: '/classement', icon: 'stats', label: 'Classement' },
  { href: '/profil', icon: 'profile', label: 'Profil' },
];
---

<aside class="hidden md:flex fixed left-0 top-1/2 -translate-y-1/2 w-16 bg-[#8C17F8] rounded-r-[32px] flex-col items-center py-12 shadow-[10px_0_30px_rgba(140,23,248,0.25)] z-40">
  
  <div class="flex flex-col w-full gap-4 relative">
    {navItems.map((item) => {
      const isActive = currentPath === item.href;
      
      return (
        <a href={item.href} class="relative w-full h-[64px] flex items-center justify-center group outline-none" aria-label={item.label}>
          
          {/* LE CERCLE ACTIF (Bulle) */}
          {/* CORRECTION : Suppression de la bordure pour fusionner parfaitement les couleurs */}
          {isActive && (
            <div class="absolute right-[-32px] top-1/2 -translate-y-1/2 w-[72px] h-[72px] bg-[#8C17F8] rounded-full z-0 pointer-events-none shadow-[4px_0_15px_rgba(140,23,248,0.35)]"></div>
          )}
          
          {/* L'ICÔNE & SES ANIMATIONS */}
          {/* CORRECTION : translate-x-[28px] au lieu de 26px pour un centrage géométrique absolu */}
          <div class={`relative z-10 flex items-center justify-center transition-all duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-active:duration-100
            ${isActive 
              ? 'translate-x-[28px] text-white scale-[1.3] drop-shadow-[0_0_8px_rgba(255,255,255,0.4)] animate-float group-active:scale-[1.15]' 
              : 'text-white/50 group-hover:text-white group-hover:scale-110 group-hover:-translate-y-1 group-active:scale-90 group-active:text-white/90 group-active:-translate-y-0'
            }`}
          >
            
            {/* ICÔNE : ACCUEIL */}
            {item.icon === 'home' && (
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.592 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
              </svg>
            )}
            
            {/* ICÔNE : BIBLIOTHÈQUE */}
            {item.icon === 'book' && (
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
              </svg>
            )}
            
            {/* ICÔNE : CLASSEMENT/STATS */}
            {item.icon === 'stats' && (
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
              </svg>
            )}
            
            {/* ICÔNE : PROFIL */}
            {item.icon === 'profile' && (
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
              </svg>
            )}

          </div>
        </a>
      );
    })}
  </div>
</aside>

<style>
  /* Ajoute un très léger mouvement de flottaison continu sur l'icône active */
  .animate-float {
    animation: float 4s ease-in-out infinite;
  }

  /* Les animations ont été ajustées pour correspondre à la nouvelle position X (28px) */
  @keyframes float {
    0% { transform: translateX(28px) translateY(0px) scale(1.3); }
    50% { transform: translateX(28px) translateY(-3px) scale(1.3); }
    100% { transform: translateX(28px) translateY(0px) scale(1.3); }
  }
</style>