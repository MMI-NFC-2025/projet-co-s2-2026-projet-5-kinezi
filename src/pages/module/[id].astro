---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/SiteHeader.astro'; 
import Menu from '../../components/Menu.astro';     
import Sidebar from '../../components/Sidebar.astro'; 
import PocketBase from 'pocketbase';

const pb = new PocketBase('http://127.0.0.1:8090');

// 1. On dit à Astro de générer une page pour chaque module de ta base
export async function getStaticPaths() {
  const pb = new PocketBase('http://127.0.0.1:8090');
  const modules = await pb.collection('modules').getFullList();
  
  return modules.map((mod) => ({
    params: { id: mod.id }, // L'URL sera /module/l-id-du-module
    props: { moduleData: mod },
  }));
}

const { moduleData } = Astro.props;

// 2. On récupère les leçons qui appartiennent SEULEMENT à ce module
// Sécurité TypeScript : On précise que c'est un tableau
let subLessons: any[] = []; 
try {
  subLessons = await pb.collection('lessons').getFullList({
    filter: `module = "${moduleData.id}"`, // La relation qu'on a créée !
    sort: 'created',
  });
} catch (error) {
  console.error("Erreur de récupération des leçons :", error);
}
---

<Layout title={`${moduleData.title} | Kinezi`}>
  
  <Header />
  <Menu />
  <Sidebar />

  <main class="min-h-screen bg-[#F8F9FA] md:ml-20 pt-32 pb-24 px-6 md:px-12">
    <div class="max-w-[1000px] mx-auto">
      
      <a href="javascript:history.back()" class="inline-flex items-center gap-2 text-gray-500 font-bold hover:text-[#A898EE] transition-colors mb-8 group">
        <svg class="w-5 h-5 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M15 19l-7-7 7-7"></path>
        </svg>
        Retour
      </a>

      <div class="bg-white rounded-[2rem] p-6 md:p-10 shadow-[0_4px_20px_rgba(0,0,0,0.03)] border border-gray-100 mb-12 flex flex-col md:flex-row gap-8 items-center md:items-start relative overflow-hidden">
        
        <div class="w-40 h-40 md:w-48 md:h-48 flex-shrink-0 bg-[#A898EE] rounded-[1.5rem] flex items-center justify-center shadow-inner">
        </div>

        <div class="flex-1 text-center md:text-left flex flex-col justify-center">
          <h1 class="text-4xl md:text-5xl font-black text-gray-900 tracking-tight mb-4">
            {moduleData.title}
          </h1>
          <p class="text-gray-500 font-medium text-lg mb-8 max-w-xl">
            {moduleData.description}
          </p>

          <div class="flex items-center justify-center md:justify-start gap-4">
            <button class="bg-[#A898EE] text-white font-bold py-3 px-8 rounded-full hover:bg-[#9685db] transition-colors shadow-md hover:shadow-lg hover:-translate-y-0.5">
              Commencer
            </button>
            
            {/* BOUTON LIKE - On garde le hover lavande initial, le script gérera le violet sombre */}
            <button id="like-btn" data-module-id={moduleData.id} class="w-12 h-12 rounded-full flex items-center justify-center border-2 border-gray-200 bg-white text-gray-400 hover:border-[#A898EE] hover:text-[#A898EE] transition-all duration-300">
              <svg class="w-6 h-6 transition-transform duration-300 hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <h2 class="text-2xl font-black text-gray-900 tracking-tight mb-8">
        Leçons dans ce module
      </h2>

      {subLessons.length === 0 ? (
        <p class="text-gray-500">Aucune leçon n'a encore été ajoutée dans ce module.</p>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {subLessons.map((lesson, index) => (
            {/* CORRECTION ICI : Ajout des ombres élégantes (shadow-[0_8px_24px_...]) et du hover violet pour harmoniser avec la bibliothèque */}
            <a href={`/lecon/${lesson.id}`} class="group flex items-center gap-4 bg-white rounded-2xl p-4 shadow-[0_8px_24px_rgba(0,0,0,0.06)] border border-gray-100 hover:shadow-[0_12px_32px_rgba(140,23,248,0.12)] hover:border-[#A898EE]/30 transition-all duration-300 hover:-translate-y-1">
              <div class="w-12 h-12 bg-gray-50 rounded-xl flex items-center justify-center text-gray-400 font-black text-lg group-hover:bg-[#A898EE]/10 group-hover:text-[#A898EE] transition-colors">
                {index + 1}
              </div>
              <div class="flex-1">
                <h3 class="font-bold text-gray-900 group-hover:text-[#A898EE] transition-colors">{lesson.title}</h3>
                <p class="text-sm text-gray-400">Vidéo</p>
              </div>
              <div class="w-10 h-10 bg-gray-50 rounded-full flex items-center justify-center text-gray-400 group-hover:bg-[#A898EE] group-hover:text-white transition-all">
                <svg class="w-5 h-5 ml-1" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      )}

    </div>
  </main>
</Layout>

{/* --- LE SCRIPT QUI PARLE À POCKETBASE --- */}
<script>
  import PocketBase from 'pocketbase';
  
  document.addEventListener('astro:page-load', async () => {
    const pb = new PocketBase('http://127.0.0.1:8090');
    const likeBtn = document.getElementById('like-btn');
    
    if (!likeBtn) return;
    
    const moduleId = likeBtn.dataset.moduleId;
    const svg = likeBtn.querySelector('svg');
    let favoriteRecordId: string | null = null;

    if (pb.authStore.isValid && pb.authStore.model) {
      const userId = pb.authStore.model.id;
      
      try {
        const record = await pb.collection('favorites').getFirstListItem(`user="${userId}" && module="${moduleId}"`);
        favoriteRecordId = record.id;
        
        // État LIKÉ (Violet sombre au chargement)
        likeBtn.classList.add('border-[#533483]', 'bg-[#533483]/10', 'text-[#533483]');
        likeBtn.classList.remove('border-gray-200', 'bg-white', 'text-gray-400');
        if (svg) svg.setAttribute('fill', 'currentColor');
      } catch (e) {
        // L'utilisateur n'a pas encore liké ce module
      }

      likeBtn.addEventListener('click', async () => {
        const isCurrentlyLiked = !!favoriteRecordId;
        
        if (isCurrentlyLiked) {
          // Retire le style Violet Sombre
          likeBtn.classList.remove('border-[#533483]', 'bg-[#533483]/10', 'text-[#533483]');
          likeBtn.classList.add('border-gray-200', 'bg-white', 'text-gray-400');
          if (svg) svg.setAttribute('fill', 'none');
          
          if (favoriteRecordId) {
            await pb.collection('favorites').delete(favoriteRecordId);
            favoriteRecordId = null;
          }
        } else {
          // Ajoute le style Violet Sombre
          likeBtn.classList.add('border-[#533483]', 'bg-[#533483]/10', 'text-[#533483]');
          likeBtn.classList.remove('border-gray-200', 'bg-white', 'text-gray-400');
          if (svg) svg.setAttribute('fill', 'currentColor');
          
          const newRecord = await pb.collection('favorites').create({
            user: userId,
            module: moduleId
          });
          favoriteRecordId = newRecord.id;
        }
      });
      
    } else {
      likeBtn.addEventListener('click', () => {
        alert("Tu dois te connecter pour ajouter des leçons à tes favoris !");
      });
    }
  });
</script>