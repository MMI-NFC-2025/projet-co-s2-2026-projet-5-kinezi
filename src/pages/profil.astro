---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Sidebar from '../components/Sidebar.astro';
---

<Layout title="Kinezi | Votre Profil">
  <main class="h-[100dvh] bg-[#A898EE] flex flex-col items-center justify-start md:justify-between pb-8 overflow-y-auto overflow-x-hidden md:overflow-hidden relative w-full md:pl-24">
    
    <Sidebar />

    <div class="w-full z-50">
      <SiteHeader />
    </div>

    <div class="w-full pt-28 md:pt-32 pb-2 md:pb-4 flex flex-col items-center relative z-10 shrink-0">
      
      <input type="file" id="avatar-upload" accept="image/*" class="hidden" />

      <div id="avatar-container" class="animate-fade-in-up relative w-36 h-36 md:w-24 md:h-24 rounded-full border-[5px] md:border-4 border-white flex items-center justify-center mb-3 md:mb-4 shadow-[0_0_25px_rgba(255,255,255,0.4)] bg-white/20 backdrop-blur-md transition-transform hover:scale-105 cursor-pointer overflow-hidden group">
        
        <img id="avatar-preview" src="" alt="Votre photo de profil" class="absolute inset-0 w-full h-full object-cover hidden z-10" />
        
        <svg id="avatar-default" xmlns="http://www.w3.org/2000/svg" class="w-20 h-20 md:w-14 md:h-14 text-white drop-shadow-sm" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd" />
        </svg>

        <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity z-20">
          <svg class="w-8 h-8 md:w-6 md:h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
          </svg>
        </div>
      </div>
      
      <div id="name-display-container" class="animate-fade-in-up flex items-center gap-3 mt-1 md:mt-0">
        <h2 id="user-name" class="text-white text-4xl md:text-3xl font-black tracking-tight drop-shadow-md">
          Chargement...
        </h2>
        <button id="edit-name-btn" class="w-8 h-8 rounded-full bg-white/20 hover:bg-white/40 flex items-center justify-center text-white transition-colors cursor-pointer" title="Modifier mon prénom">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
        </button>
      </div>

      <form id="edit-name-form" class="hidden animate-fade-in-up flex items-center gap-2 mt-1 md:mt-0">
        <input type="text" id="name-input" class="bg-white/20 text-white placeholder-white/60 border border-white/40 rounded-full px-4 py-2 outline-none focus:ring-2 focus:ring-white font-bold w-40 text-center" placeholder="Ton pseudo..." />
        <button type="submit" class="w-10 h-10 rounded-full bg-green-500 hover:bg-green-600 flex items-center justify-center text-white shadow-md transition-colors" title="Sauvegarder">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
        </button>
        <button type="button" id="cancel-name-btn" class="w-10 h-10 rounded-full bg-red-400 hover:bg-red-500 flex items-center justify-center text-white shadow-md transition-colors" title="Annuler">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </form>

      <div class="animate-fade-in-up delay-100 w-full max-w-[340px] md:max-w-md mt-6 flex items-center justify-center gap-3 md:gap-4 px-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-yellow-500 drop-shadow-md transition-transform hover:scale-110 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M5.166 2.621v.858c-1.035.148-2.059.33-3.071.543a.75.75 0 00-.584.859 6.753 6.753 0 006.138 5.6 27.395 27.395 0 002.208.036v1.455A4.507 4.507 0 007.5 16v1.5c0 .356.255.66.605.733l4.5 1.05v1.217h-2.25a.75.75 0 000 1.5h3.75a.75.75 0 000-1.5h-2.25v-1.217l4.5-1.05a.75.75 0 00.605-.733V16a4.507 4.507 0 00-2.342-3.968v-1.455c.732-.01 1.467-.024 2.208-.036a6.753 6.753 0 006.138-5.6.75.75 0 00-.584-.859 40.428 40.428 0 00-3.071-.543v-.858a.75.75 0 00-.75-.75H5.916a.75.75 0 00-.75.75zm1.5.75v1.492c.67-.065 1.344-.122 2.023-.171v-1.32h-2.023zm10.668 0v1.32c.68.05 1.353.106 2.023.171v-1.491h-2.023z" clip-rule="evenodd" /></svg>
        <div class="flex-1 h-3.5 bg-black/20 rounded-full flex shadow-inner overflow-hidden border border-white/20 backdrop-blur-sm">
          <div id="xp-bar" class="h-full bg-white w-0 rounded-full relative overflow-hidden shadow-[0_0_12px_rgba(255,255,255,0.8)] transition-all duration-1000 ease-out">
            <div class="absolute top-0 left-0 w-full h-1/2 bg-white/50"></div>
          </div>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white/50 transition-transform hover:scale-110 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M5.166 2.621v.858c-1.035.148-2.059.33-3.071.543a.75.75 0 00-.584.859 6.753 6.753 0 006.138 5.6 27.395 27.395 0 002.208.036v1.455A4.507 4.507 0 007.5 16v1.5c0 .356.255.66.605.733l4.5 1.05v1.217h-2.25a.75.75 0 000 1.5h3.75a.75.75 0 000-1.5h-2.25v-1.217l4.5-1.05a.75.75 0 00.605-.733V16a4.507 4.507 0 00-2.342-3.968v-1.455c.732-.01 1.467-.024 2.208-.036a6.753 6.753 0 006.138-5.6.75.75 0 00-.584-.859 40.428 40.428 0 00-3.071-.543v-.858a.75.75 0 00-.75-.75H5.916a.75.75 0 00-.75.75zm1.5.75v1.492c.67-.065 1.344-.122 2.023-.171v-1.32h-2.023zm10.668 0v1.32c.68.05 1.353.106 2.023.171v-1.491h-2.023z" clip-rule="evenodd" /></svg>
      </div>
    </div>

    <div class="hidden md:flex animate-fade-in-up delay-200 w-full max-w-4xl flex-1 flex-row items-stretch justify-center gap-6 px-6 shrink-0 my-auto py-8">
      
      <div class="flex-1 bg-white/95 backdrop-blur-md rounded-[32px] p-6 flex flex-col justify-center gap-4 shadow-[0_15px_35px_rgba(76,29,149,0.2)] border border-white/40 w-full">
        <div class="bg-[#F4F0FF] rounded-2xl px-5 py-4 flex items-center gap-4 transition-colors hover:bg-[#EAE4FF] cursor-default border border-white/50 shadow-sm">
          <span class="text-2xl leading-none drop-shadow-sm">🔥</span>
          <span id="pc-streak" class="font-black text-gray-800 text-xl">0 Jours</span>
        </div>
        <div class="bg-[#F4F0FF] rounded-2xl px-5 py-4 flex items-center gap-4 transition-colors hover:bg-[#EAE4FF] cursor-default border border-white/50 shadow-sm">
          <span class="text-2xl leading-none drop-shadow-sm">🏆</span>
          <span id="pc-rank" class="font-black text-gray-800 text-xl">-</span>
        </div>
      </div>
      
      <div class="relative w-28 h-28 self-center shrink-0">
        <div class="absolute inset-0 rounded-full bg-green-400 animate-ping opacity-20"></div>
        <div class="relative w-full h-full bg-white rounded-full flex items-center justify-center shadow-[0_10px_25px_rgba(34,197,94,0.3)] transition-transform hover:scale-110 cursor-pointer border border-white/40">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-14 h-14 text-green-500 drop-shadow-sm" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M14.615 1.595a.75.75 0 01.359.852L12.982 9.75h7.268a.75.75 0 01.548 1.262l-10.5 11.25a.75.75 0 01-1.272-.71l1.992-7.302H3.75a.75.75 0 01-.548-1.262l10.5-11.25a.75.75 0 01.913-.143z" clip-rule="evenodd" /></svg>
        </div>
      </div>

      <div class="flex-1 bg-white/95 backdrop-blur-md rounded-[32px] p-6 flex flex-col items-center justify-center shadow-[0_15px_35px_rgba(76,29,149,0.2)] border border-white/40 w-full">
        <span class="text-gray-500 font-extrabold uppercase tracking-widest text-xs mb-2">Expérience</span>
        <div class="flex items-baseline gap-1">
          <span id="pc-xp" class="text-6xl font-black text-[#8C17F8] tracking-tight">0</span>
          <span class="text-xl font-bold text-gray-600">exp</span>
        </div>
      </div>

    </div>

    <div class="hidden md:flex animate-fade-in-up delay-300 w-full shrink-0 flex-wrap items-center justify-center gap-4 px-6">
      <button class="bg-[#8C17F8] px-6 py-3.5 rounded-full flex items-center gap-3 shadow-[0_10px_25px_rgba(76,29,149,0.3)] active:scale-95 group transition-all hover:-translate-y-1 hover:shadow-[0_15px_30px_rgba(76,29,149,0.4)]">
        <span class="font-black text-white text-base">Partager mon profil</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M3.478 2.405a.75.75 0 00-.926.94l2.432 7.905H13.5a.75.75 0 010 1.5H4.984l-2.432 7.905a.75.75 0 00.926.94 60.519 60.519 0 0018.445-8.986.75.75 0 000-1.218A60.517 60.517 0 003.478 2.405z" /></svg>
      </button>
      <button class="relative overflow-hidden bg-[#8C17F8] px-8 py-3.5 rounded-full font-black text-lg text-white shadow-[0_10px_25px_rgba(76,29,149,0.3)] transition-all active:scale-95 group hover:-translate-y-1 hover:shadow-[0_15px_30px_rgba(76,29,149,0.4)]">
        <span class="absolute inset-0 bg-white/10 translate-y-full group-hover:translate-y-0 transition-transform duration-300 rounded-full"></span>
        <span class="relative z-10">Ajouter des amis</span>
      </button>
      <button class="bg-[#8C17F8] w-14 h-14 rounded-full flex items-center justify-center shadow-[0_10px_25px_rgba(76,29,149,0.3)] active:scale-95 text-white transition-all hover:-translate-y-1 hover:shadow-[0_15px_30px_rgba(76,29,149,0.4)]">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M21.731 2.269a2.625 2.625 0 00-3.712 0l-1.157 1.158 3.71 3.71 1.159-1.158a2.625 2.625 0 000-3.71zm-2.904 6.624L5.113 22.607a4.5 4.5 0 01-1.625 1.056l-3.322 1.253a.75.75 0 01-.963-.963l1.253-3.322a4.5 4.5 0 011.056-1.625l13.714-13.714 3.711 3.711z" /></svg>
      </button>
    </div>

    <div class="flex md:hidden w-full max-w-[400px] flex-row items-center justify-center px-2 mt-8 mb-6 animate-fade-in-up delay-200 shrink-0">
      
      <div class="flex flex-col gap-3.5 z-10 w-[150px]">
        <div class="bg-white rounded-full py-3.5 px-4 flex items-center justify-start gap-2.5 shadow-md pr-8">
          <span class="text-2xl leading-none">🔥</span>
          <span id="mob-streak" class="font-black text-base text-gray-900 whitespace-nowrap">0 Jours</span>
        </div>
        <div class="bg-white rounded-full py-3.5 px-4 flex items-center justify-start gap-2.5 shadow-md pr-8">
          <span class="text-2xl leading-none">🏆</span>
          <span id="mob-rank" class="font-black text-base text-gray-900 whitespace-nowrap">-</span>
        </div>
      </div>
      
      <div class="relative w-[128px] h-[128px] bg-white rounded-full flex items-center justify-center shadow-lg z-20 shrink-0 -mx-8 border-[8px] border-[#A898EE]">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-14 h-14 text-green-500" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" d="M14.615 1.595a.75.75 0 01.359.852L12.982 9.75h7.268a.75.75 0 01.548 1.262l-10.5 11.25a.75.75 0 01-1.272-.71l1.992-7.302H3.75a.75.75 0 01-.548-1.262l10.5-11.25a.75.75 0 01.913-.143z" clip-rule="evenodd" />
        </svg>
      </div>

      <div class="bg-white rounded-r-[36px] rounded-l-none py-7 pl-12 pr-5 shadow-md z-10 w-[130px] flex items-center justify-center">
        <span id="mob-xp" class="font-black text-base text-gray-900 whitespace-nowrap">0 exp</span>
      </div>

    </div>

    <div class="flex md:hidden w-full max-w-[380px] flex-col gap-5 px-4 mt-2 mb-auto animate-fade-in-up delay-300 shrink-0">
      
      <div class="flex flex-row justify-center gap-3 w-full">
        <button class="bg-[#8C17F8] flex-1 rounded-full py-3.5 flex justify-center items-center gap-2 shadow-md active:scale-95 transition-transform">
          <span class="font-black text-white text-sm">Partager mon profil</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3.478 2.405a.75.75 0 00-.926.94l2.432 7.905H13.5a.75.75 0 010 1.5H4.984l-2.432 7.905a.75.75 0 00.926.94 60.519 60.519 0 0018.445-8.986.75.75 0 000-1.218A60.517 60.517 0 003.478 2.405z" />
          </svg>
        </button>
        <button class="bg-[#8C17F8] w-14 h-14 shrink-0 rounded-full flex items-center justify-center shadow-md active:scale-95 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
            <path d="M21.731 2.269a2.625 2.625 0 00-3.712 0l-1.157 1.158 3.71 3.71 1.159-1.158a2.625 2.625 0 000-3.71zm-2.904 6.624L5.113 22.607a4.5 4.5 0 01-1.625 1.056l-3.322 1.253a.75.75 0 01-.963-.963l1.253-3.322a4.5 4.5 0 011.056-1.625l13.714-13.714 3.711 3.711z" />
          </svg>
        </button>
      </div>

      <button class="bg-[#8C17F8] text-white w-full rounded-full py-5 font-black text-2xl tracking-wide shadow-xl active:scale-95 transition-transform">
        Ajouter des amis
      </button>

    </div>

  </main>
</Layout>

<script>
  import PocketBase from 'pocketbase';

  const loadProfileData = async () => {
    const pb = new PocketBase('http://127.0.0.1:8090');

    if (!pb.authStore.isValid) {
      window.location.href = '/login-mail';
      return;
    }

    let user = pb.authStore.model;

    // --- ELEMENTS UI DU NOM ---
    const nameContainer = document.getElementById('name-display-container');
    const nameElement = document.getElementById('user-name');
    const editNameBtn = document.getElementById('edit-name-btn');
    const editNameForm = document.getElementById('edit-name-form');
    const nameInput = document.getElementById('name-input');
    const cancelNameBtn = document.getElementById('cancel-name-btn');

    if (nameElement) nameElement.textContent = user.first_name || 'Utilisateur';

    // --- LOGIQUE POUR CHANGER LE PRÉNOM ---
    if (editNameBtn && editNameForm && nameContainer && cancelNameBtn && nameInput) {
      editNameBtn.addEventListener('click', () => {
        nameContainer.classList.add('hidden');
        editNameForm.classList.remove('hidden');
        nameInput.value = user.first_name || '';
        nameInput.focus();
      });

      cancelNameBtn.addEventListener('click', () => {
        editNameForm.classList.add('hidden');
        nameContainer.classList.remove('hidden');
      });

      editNameForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const newName = nameInput.value.trim();
        if (!newName) return;
        try {
          const updatedUser = await pb.collection('users').update(user.id, { first_name: newName });
          user = updatedUser;
          nameElement.textContent = user.first_name;
          editNameForm.classList.add('hidden');
          nameContainer.classList.remove('hidden');
        } catch (error) {
          console.error("Erreur sauvegarde prénom:", error);
        }
      });
    }

    // --- MISE À JOUR DE L'AVATAR ---
    const avatarPreview = document.getElementById('avatar-preview');
    const avatarDefault = document.getElementById('avatar-default');
    if (user.avatar && avatarPreview && avatarDefault) {
      avatarPreview.src = pb.files.getUrl(user, user.avatar);
      avatarPreview.classList.remove('hidden');
      avatarDefault.classList.add('hidden');
    }

    // --- LOGIQUE UPLOAD PHOTO ---
    const container = document.getElementById('avatar-container');
    const input = document.getElementById('avatar-upload');
    if (container && input) {
      container.addEventListener('click', () => input.click());
      input.addEventListener('change', async (e) => {
        const file = e.target.files[0];
        if (file) {
          const formData = new FormData();
          formData.append('avatar', file);
          try {
            await pb.collection('users').update(user.id, formData);
            window.location.reload(); 
          } catch (error) {
            console.error("Erreur upload:", error);
          }
        }
      });
    }

    // --- RECUPERATION DES STATS + JAUGE DYNAMIQUE ---
    try {
      const stats = await pb.collection('user_stats').getFirstListItem(`user="${user.id}"`);
      
      const pcStreak = document.getElementById('pc-streak');
      const pcRank = document.getElementById('pc-rank');
      const pcXp = document.getElementById('pc-xp');
      const mobStreak = document.getElementById('mob-streak');
      const mobRank = document.getElementById('mob-rank');
      const mobXp = document.getElementById('mob-xp');

      if(pcStreak) pcStreak.textContent = `${stats.streak_days} Jours`;
      if(pcRank) pcRank.textContent = stats.rank_tier || 'Débutant';
      if(pcXp) pcXp.textContent = stats.experience_points;
      if(mobStreak) mobStreak.textContent = `${stats.streak_days} Jours`;
      if(mobRank) mobRank.textContent = stats.rank_tier || 'Débutant';
      if(mobXp) mobXp.textContent = `${stats.experience_points} exp`;

      const xpGoal = 1000;
      const progressPercentage = Math.min((stats.experience_points / xpGoal) * 100, 100);
      const xpBar = document.getElementById('xp-bar');
      if (xpBar) xpBar.style.width = `${progressPercentage}%`;

    } catch (error) {
      console.log("Initialisation des stats à zéro");
      const xpBar = document.getElementById('xp-bar');
      if (xpBar) xpBar.style.width = '0%';
    }
  };

  loadProfileData();
  document.addEventListener('astro:page-load', loadProfileData);
</script>

<style>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    opacity: 0;
    animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .delay-100 { animation-delay: 100ms; }
  .delay-200 { animation-delay: 200ms; }
  .delay-300 { animation-delay: 300ms; }
</style>