---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
---

<Layout title="Kinezi | Votre Profil">
  <main class="h-[100dvh] bg-[#A898EE] flex flex-col items-center justify-start md:justify-between pb-8 overflow-y-auto overflow-x-hidden md:overflow-hidden relative w-full">
    
    <div class="w-full z-50">
      <SiteHeader />
    </div>

    <div class="w-full pt-28 md:pt-32 pb-2 md:pb-4 flex flex-col items-center relative z-10 shrink-0">
      
      <div class="animate-fade-in-up relative w-36 h-36 md:w-24 md:h-24 rounded-full border-[5px] md:border-4 border-white flex items-center justify-center mb-3 md:mb-4 shadow-[0_0_25px_rgba(255,255,255,0.4)] bg-white/20 backdrop-blur-md transition-transform hover:scale-105 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-20 h-20 md:w-14 md:h-14 text-white drop-shadow-sm" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd" />
        </svg>
      </div>
      
      <h2 class="animate-fade-in-up text-white text-4xl md:text-3xl font-black tracking-tight drop-shadow-md mt-1 md:mt-0">Thomas</h2>

      <div class="animate-fade-in-up delay-100 w-full max-w-[340px] md:max-w-md mt-6 flex items-center justify-center gap-3 md:gap-4 px-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-yellow-500 drop-shadow-md transition-transform hover:scale-110 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M5.166 2.621v.858c-1.035.148-2.059.33-3.071.543a.75.75 0 00-.584.859 6.753 6.753 0 006.138 5.6 27.395 27.395 0 002.208.036v1.455A4.507 4.507 0 007.5 16v1.5c0 .356.255.66.605.733l4.5 1.05v1.217h-2.25a.75.75 0 000 1.5h3.75a.75.75 0 000-1.5h-2.25v-1.217l4.5-1.05a.75.75 0 00.605-.733V16a4.507 4.507 0 00-2.342-3.968v-1.455c.732-.01 1.467-.024 2.208-.036a6.753 6.753 0 006.138-5.6.75.75 0 00-.584-.859 40.428 40.428 0 00-3.071-.543v-.858a.75.75 0 00-.75-.75H5.916a.75.75 0 00-.75.75zm1.5.75v1.492c.67-.065 1.344-.122 2.023-.171v-1.32h-2.023zm10.668 0v1.32c.68.05 1.353.106 2.023.171v-1.491h-2.023z" clip-rule="evenodd" /></svg>
        
        <div class="flex-1 h-3.5 bg-black/20 rounded-full flex shadow-inner overflow-hidden border border-white/20 backdrop-blur-sm">
          <div class="h-full bg-white w-[85%] md:w-3/4 rounded-full relative overflow-hidden shadow-[0_0_12px_rgba(255,255,255,0.8)]"><div class="absolute top-0 left-0 w-full h-1/2 bg-white/50"></div></div>
        </div>
        
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white/50 transition-transform hover:scale-110 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M5.166 2.621v.858c-1.035.148-2.059.33-3.071.543a.75.75 0 00-.584.859 6.753 6.753 0 006.138 5.6 27.395 27.395 0 002.208.036v1.455A4.507 4.507 0 007.5 16v1.5c0 .356.255.66.605.733l4.5 1.05v1.217h-2.25a.75.75 0 000 1.5h3.75a.75.75 0 000-1.5h-2.25v-1.217l4.5-1.05a.75.75 0 00.605-.733V16a4.507 4.507 0 00-2.342-3.968v-1.455c.732-.01 1.467-.024 2.208-.036a6.753 6.753 0 006.138-5.6.75.75 0 00-.584-.859 40.428 40.428 0 00-3.071-.543v-.858a.75.75 0 00-.75-.75H5.916a.75.75 0 00-.75.75zm1.5.75v1.492c.67-.065 1.344-.122 2.023-.171v-1.32h-2.023zm10.668 0v1.32c.68.05 1.353.106 2.023.171v-1.491h-2.023z" clip-rule="evenodd" /></svg>
      </div>
    </div>


    <div class="hidden md:flex animate-fade-in-up delay-200 w-full max-w-4xl flex-1 flex-row items-stretch justify-center gap-6 px-6 shrink-0 my-auto py-8">
      
      <div class="flex-1 bg-white/95 backdrop-blur-md rounded-[32px] p-6 flex flex-col justify-center gap-4 shadow-[0_15px_35px_rgba(76,29,149,0.2)] border border-white/40 w-full">
        <div class="bg-gray-50/80 rounded-2xl px-5 py-4 flex items-center gap-4 border border-gray-100 transition-colors hover:bg-gray-100/80 cursor-default">
          <span class="text-2xl leading-none drop-shadow-sm">🔥</span>
          <span class="font-black text-gray-800 text-xl">20 Jours</span>
        </div>
        <div class="bg-gray-50/80 rounded-2xl px-5 py-4 flex items-center gap-4 border border-gray-100 transition-colors hover:bg-gray-100/80 cursor-default">
          <span class="text-2xl leading-none drop-shadow-sm">🏆</span>
          <span class="font-black text-gray-800 text-xl">Bronze</span>
        </div>
      </div>
      
      <div class="relative w-40 h-40 self-center shrink-0">
        <div class="absolute inset-0 rounded-full bg-green-400 animate-ping opacity-20"></div>
        <div class="relative w-full h-full bg-white rounded-full flex items-center justify-center shadow-[0_10px_25px_rgba(34,197,94,0.3)] transition-transform hover:scale-110 cursor-pointer border border-white/40">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-20 h-20 text-green-500 drop-shadow-sm" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M14.615 1.595a.75.75 0 01.359.852L12.982 9.75h7.268a.75.75 0 01.548 1.262l-10.5 11.25a.75.75 0 01-1.272-.71l1.992-7.302H3.75a.75.75 0 01-.548-1.262l10.5-11.25a.75.75 0 01.913-.143z" clip-rule="evenodd" /></svg>
        </div>
      </div>

      <div class="flex-1 bg-white/95 backdrop-blur-md rounded-[32px] p-6 flex flex-col items-center justify-center shadow-[0_15px_35px_rgba(76,29,149,0.2)] border border-white/40 w-full">
        <span class="text-gray-500 font-extrabold uppercase tracking-widest text-xs mb-2">Expérience</span>
        <div class="flex items-baseline gap-1">
          <span class="text-6xl font-black text-[#8C17F8] tracking-tight">564</span>
          <span class="text-xl font-bold text-gray-600">exp</span>
        </div>
      </div>

    </div>

    <div class="hidden md:flex animate-fade-in-up delay-300 w-full shrink-0 flex-wrap items-center justify-center gap-4 px-6">
      <button class="bg-[#8C17F8] px-6 py-3.5 rounded-full flex items-center gap-3 shadow-[0_10px_25px_rgba(76,29,149,0.3)] active:scale-95 group transition-all hover:-translate-y-1 hover:shadow-[0_15px_30px_rgba(76,29,149,0.4)]">
        <span class="font-black text-white text-base">Partager mon profil</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor"><path d="M3.478 2.405a.75.75 0 00-.926.94l2.432 7.905H13.5a.75.75 0 010 1.5H4.984l-2.432 7.905a.75.75 0 00.926.94 60.519 60.519 0 0018.445-8.986.75.75 0 000-1.218A60.517 60.517 0 003.478 2.405z" /></svg>
      </button>
      <button class="relative overflow-hidden bg-[#8C17F8] px-8 py-3.5 rounded-full font-black text-lg text-white shadow-[0_10px_25px_rgba(76,29,149,0.3)] transition-all active:scale-95 group hover:-translate-y-1 hover:shadow-[0_15px_30px_rgba(76,29,149,0.4)]">
        <span class="absolute inset-0 bg-white/10 translate-y-full group-hover:translate-y-0 transition-transform duration-300 rounded-full"></span>
        <span class="relative z-10">Ajouter des amis</span>
      </button>
      <button class="bg-[#8C17F8] w-14 h-14 rounded-full flex items-center justify-center shadow-[0_10px_25px_rgba(76,29,149,0.3)] active:scale-95 text-white transition-all hover:-translate-y-1 hover:shadow-[0_15px_30px_rgba(76,29,149,0.4)]">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M21.731 2.269a2.625 2.625 0 00-3.712 0l-1.157 1.158 3.71 3.71 1.159-1.158a2.625 2.625 0 000-3.71zm-2.904 6.624L5.113 22.607a4.5 4.5 0 01-1.625 1.056l-3.322 1.253a.75.75 0 01-.963-.963l1.253-3.322a4.5 4.5 0 011.056-1.625l13.714-13.714 3.711 3.711z" /></svg>
      </button>
    </div>


    <div class="flex md:hidden w-full max-w-[400px] flex-row items-center justify-center px-2 mt-8 mb-6 animate-fade-in-up delay-200 shrink-0">
      
      <div class="flex flex-col gap-3.5 z-10 w-[150px]">
        <div class="bg-white rounded-full py-3.5 px-4 flex items-center justify-start gap-2.5 shadow-md pr-8">
          <span class="text-2xl leading-none">🔥</span>
          <span class="font-black text-base text-gray-900 whitespace-nowrap">20 Jours</span>
        </div>
        <div class="bg-white rounded-full py-3.5 px-4 flex items-center justify-start gap-2.5 shadow-md pr-8">
          <span class="text-2xl leading-none">🏆</span>
          <span class="font-black text-base text-gray-900 whitespace-nowrap">Bronze</span>
        </div>
      </div>
      
      <div class="relative w-[112px] h-[112px] bg-white rounded-full flex items-center justify-center shadow-lg z-20 shrink-0 -mx-7 border-[8px] border-[#A898EE]">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-green-500" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" d="M14.615 1.595a.75.75 0 01.359.852L12.982 9.75h7.268a.75.75 0 01.548 1.262l-10.5 11.25a.75.75 0 01-1.272-.71l1.992-7.302H3.75a.75.75 0 01-.548-1.262l10.5-11.25a.75.75 0 01.913-.143z" clip-rule="evenodd" />
        </svg>
      </div>

      <div class="bg-white rounded-r-[36px] rounded-l-none py-7 pl-12 pr-5 shadow-md z-10 w-[130px] flex items-center justify-center">
        <span class="font-black text-base text-gray-900 whitespace-nowrap">564 exp</span>
      </div>

    </div>

    <div class="flex md:hidden w-full max-w-[380px] flex-col gap-5 px-4 mt-2 mb-auto animate-fade-in-up delay-300 shrink-0">
      
      <div class="flex flex-row justify-center gap-3 w-full">
        <button class="bg-[#8C17F8] flex-1 rounded-full py-3.5 flex justify-center items-center gap-2 shadow-md active:scale-95 transition-transform">
          <span class="font-black text-white text-sm">Partager mon profil</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3.478 2.405a.75.75 0 00-.926.94l2.432 7.905H13.5a.75.75 0 010 1.5H4.984l-2.432 7.905a.75.75 0 00.926.94 60.519 60.519 0 0018.445-8.986.75.75 0 000-1.218A60.517 60.517 0 003.478 2.405z" />
          </svg>
        </button>
        <button class="bg-[#8C17F8] w-14 h-14 shrink-0 rounded-full flex items-center justify-center shadow-md active:scale-95 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
            <path d="M21.731 2.269a2.625 2.625 0 00-3.712 0l-1.157 1.158 3.71 3.71 1.159-1.158a2.625 2.625 0 000-3.71zm-2.904 6.624L5.113 22.607a4.5 4.5 0 01-1.625 1.056l-3.322 1.253a.75.75 0 01-.963-.963l1.253-3.322a4.5 4.5 0 011.056-1.625l13.714-13.714 3.711 3.711z" />
          </svg>
        </button>
      </div>

      <button class="bg-[#8C17F8] text-white w-full rounded-full py-5 font-black text-2xl tracking-wide shadow-xl active:scale-95 transition-transform">
        Ajouter des amis
      </button>

    </div>

  </main>
</Layout>

<style>
  @keyframes fadeInUp {
    from { 
      opacity: 0; 
      transform: translateY(20px); 
    }
    to { 
      opacity: 1; 
      transform: translateY(0); 
    }
  }

  .animate-fade-in-up {
    opacity: 0;
    animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .delay-100 { animation-delay: 100ms; }
  .delay-200 { animation-delay: 200ms; }
  .delay-300 { animation-delay: 300ms; }
</style>