---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Sidebar from '../components/Sidebar.astro';
---

<Layout title="Kinezi | Votre Profil">
  <main class="h-[100dvh] bg-[#A898EE] flex flex-col items-center justify-start md:justify-between pb-8 overflow-y-auto overflow-x-hidden md:overflow-hidden relative w-full md:pl-24">
    
    <Sidebar />

    <div class="w-full z-50">
      <SiteHeader />
    </div>

    <div class="w-full pt-28 md:pt-32 pb-2 md:pb-4 flex flex-col items-center relative z-10 shrink-0">
      
      <input type="file" id="avatar-upload" accept="image/*" class="hidden" />

      <div id="avatar-container" class="animate-fade-in-up relative w-36 h-36 md:w-24 md:h-24 rounded-full border-[5px] md:border-4 border-white flex items-center justify-center mb-3 md:mb-4 shadow-[0_0_25px_rgba(255,255,255,0.4)] bg-white/20 backdrop-blur-md transition-transform hover:scale-105 cursor-pointer overflow-hidden group">
        
        <img id="avatar-preview" src="" alt="Votre photo de profil" class="absolute inset-0 w-full h-full object-cover hidden z-10" />
        
        <svg id="avatar-default" xmlns="http://www.w3.org/2000/svg" class="w-20 h-20 md:w-14 md:h-14 text-white drop-shadow-sm" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" clip-rule="evenodd" />
        </svg>

        <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity z-20">
          <svg class="w-8 h-8 md:w-6 md:h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
          </svg>
        </div>
      </div>
      
      <div id="name-display-container" class="animate-fade-in-up flex items-center gap-3 mt-1 md:mt-0">
        <h2 id="user-name" class="text-white text-4xl md:text-3xl font-black tracking-tight drop-shadow-md">
          Chargement...
        </h2>
        <button id="edit-name-btn" class="w-8 h-8 rounded-full bg-white/20 hover:bg-white/40 flex items-center justify-center text-white transition-colors cursor-pointer" title="Modifier mon prénom">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
        </button>
      </div>

      <form id="edit-name-form" class="hidden animate-fade-in-up items-center gap-2 mt-1 md:mt-0">
        <input type="text" id="name-input" class="bg-white/20 text-white placeholder-white/60 border border-white/40 rounded-full px-4 py-2 outline-none focus:ring-2 focus:ring-white font-bold w-40 text-center" placeholder="Ton pseudo..." />
        <button type="submit" class="w-10 h-10 rounded-full bg-green-500 hover:bg-green-600 flex items-center justify-center text-white shadow-md transition-colors" title="Sauvegarder">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
        </button>
        <button type="button" id="cancel-name-btn" class="w-10 h-10 rounded-full bg-red-400 hover:bg-red-500 flex items-center justify-center text-white shadow-md transition-colors" title="Annuler">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </form>

      <div class="animate-fade-in-up delay-100 w-full max-w-[340px] md:max-w-md mt-6 flex items-center justify-center gap-3 md:gap-4 px-4 relative group cursor-pointer" title="Objectif de niveau : 1000 XP">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-yellow-500 drop-shadow-md transition-transform group-hover:scale-110 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M5.166 2.621v.858c-1.035.148-2.059.33-3.071.543a.75.75 0 00-.584.859 6.753 6.753 0 006.138 5.6 27.395 27.395 0 002.208.036v1.455A4.507 4.507 0 007.5 16v1.5c0 .356.255.66.605.733l4.5 1.05v1.217h-2.25a.75.75 0 000 1.5h3.75a.75.75 0 000-1.5h-2.25v-1.217l4.5-1.05a.75.75 0 00.605-.733V16a4.507 4.507 0 00-2.342-3.968v-1.455c.732-.01 1.467-.024 2.208-.036a6.753 6.753 0 006.138-5.6.75.75 0 00-.584-.859 40.428 40.428 0 00-3.071-.543v-.858a.75.75 0 00-.75-.75H5.916a.75.75 0 00-.75.75zm1.5.75v1.492c.67-.065 1.344-.122 2.023-.171v-1.32h-2.023zm10.668 0v1.32c.68.05 1.353.106 2.023.171v-1.491h-2.023z" clip-rule="evenodd" /></svg>
        <div class="flex-1 h-4 bg-black/20 rounded-full flex shadow-inner overflow-hidden border border-white/20 backdrop-blur-sm">
          <div id="xp-bar" class="h-full bg-white w-0 rounded-full relative overflow-hidden shadow-[0_0_12px_rgba(255,255,255,0.8)] transition-all duration-1000 ease-out">
            <div class="absolute top-0 left-0 w-full h-1/2 bg-white/50"></div>
          </div>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white/50 transition-transform group-hover:scale-110 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M5.166 2.621v.858c-1.035.148-2.059.33-3.071.543a.75.75 0 00-.584.859 6.753 6.753 0 006.138 5.6 27.395 27.395 0 002.208.036v1.455A4.507 4.507 0 007.5 16v1.5c0 .356.255.66.605.733l4.5 1.05v1.217h-2.25a.75.75 0 000 1.5h3.75a.75.75 0 000-1.5h-2.25v-1.217l4.5-1.05a.75.75 0 00.605-.733V16a4.507 4.507 0 00-2.342-3.968v-1.455c.732-.01 1.467-.024 2.208-.036a6.753 6.753 0 006.138-5.6.75.75 0 00-.584-.859 40.428 40.428 0 00-3.071-.543v-.858a.75.75 0 00-.75-.75H5.916a.75.75 0 00-.75.75zm1.5.75v1.492c.67-.065 1.344-.122 2.023-.171v-1.32h-2.023zm10.668 0v1.32c.68.05 1.353.106 2.023.171v-1.491h-2.023z" clip-rule="evenodd" /></svg>
      </div>
    </div>

    <div class="hidden md:flex animate-fade-in-up delay-200 w-full max-w-4xl flex-1 flex-row items-stretch justify-center gap-6 px-6 shrink-0 my-auto py-8">
      
      <div class="flex-1 bg-white/95 backdrop-blur-md rounded-[32px] p-6 flex flex-col justify-center gap-4 shadow-[0_15px_35px_rgba(76,29,149,0.2)] border border-white/40 w-full">
        <div class="bg-[#F4F0FF] rounded-2xl px-5 py-4 flex items-center gap-4 transition-colors hover:bg-[#EAE4FF] cursor-default border border-white/50 shadow-sm">
          <span class="text-2xl leading-none drop-shadow-sm">🔥</span>
          <span id="pc-streak" class="font-black text-gray-800 text-xl">0 Jours</span>
        </div>
        <div class="bg-[#F4F0FF] rounded-2xl px-5 py-4 flex items-center gap-4 transition-colors hover:bg-[#EAE4FF] cursor-default border border-white/50 shadow-sm">
          <span class="text-2xl leading-none drop-shadow-sm">🏆</span>
          <span id="pc-rank" class="font-black text-gray-800 text-xl">Apprenti</span>
        </div>
      </div>
      
      <div class="relative w-28 h-28 self-center shrink-0">
        <div class="absolute inset-0 rounded-full bg-green-400 animate-ping opacity-20"></div>
        <div class="relative w-full h-full bg-white rounded-full flex items-center justify-center shadow-[0_10px_25px_rgba(34,197,94,0.3)] transition-transform hover:scale-110 cursor-pointer border border-white/40">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-14 h-14 text-green-500 drop-shadow-sm" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M14.615 1.595a.75.75 0 01.359.852L12.982 9.75h7.268a.75.75 0 01.548 1.262l-10.5 11.25a.75.75 0 01-1.272-.71l1.992-7.302H3.75a.75.75 0 01-.548-1.262l10.5-11.25a.75.75 0 01.913-.143z" clip-rule="evenodd" /></svg>
        </div>
      </div>

      <div class="flex-1 bg-white/95 backdrop-blur-md rounded-[32px] p-6 flex flex-col items-center justify-center shadow-[0_15px_35px_rgba(76,29,149,0.2)] border border-white/40 w-full">
        <span class="text-gray-500 font-extrabold uppercase tracking-widest text-xs mb-2">Expérience Totale</span>
        <div class="flex items-baseline gap-1">
          <span id="pc-xp" class="text-6xl font-black text-[#8C17F8] tracking-tight">0</span>
          <span class="text-xl font-bold text-gray-600">XP</span>
        </div>
      </div>

    </div>

    <div class="flex md:hidden w-full max-w-[400px] flex-row items-center justify-center px-2 mt-8 mb-6 animate-fade-in-up delay-200 shrink-0">
      
      <div class="flex flex-col gap-3.5 z-10 w-[150px]">
        <div class="bg-white rounded-full py-3.5 px-4 flex items-center justify-start gap-2.5 shadow-md pr-8">
          <span class="text-2xl leading-none">🔥</span>
          <span id="mob-streak" class="font-black text-base text-gray-900 whitespace-nowrap">0 Jours</span>
        </div>
        <div class="bg-white rounded-full py-3.5 px-4 flex items-center justify-start gap-2.5 shadow-md pr-8">
          <span class="text-2xl leading-none">🏆</span>
          <span id="mob-rank" class="font-black text-base text-gray-900 whitespace-nowrap">Apprenti</span>
        </div>
      </div>
      
      <div class="relative w-[128px] h-[128px] bg-white rounded-full flex items-center justify-center shadow-lg z-20 shrink-0 -mx-8 border-[8px] border-[#A898EE]">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-14 h-14 text-green-500" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" d="M14.615 1.595a.75.75 0 01.359.852L12.982 9.75h7.268a.75.75 0 01.548 1.262l-10.5 11.25a.75.75 0 01-1.272-.71l1.992-7.302H3.75a.75.75 0 01-.548-1.262l10.5-11.25a.75.75 0 01.913-.143z" clip-rule="evenodd" />
        </svg>
      </div>

      <div class="bg-white rounded-r-[36px] rounded-l-none py-7 pl-12 pr-5 shadow-md z-10 w-[130px] flex items-center justify-center">
        <span id="mob-xp" class="font-black text-base whitespace-nowrap text-[#8C17F8]">0 XP</span>
      </div>

    </div>

  </main>
</Layout>

<script>
  import { pb } from '../lib/pb.js'; // Remets ton import PocketBase correctement configuré !

  const loadProfileData = async () => {
    if (!pb.authStore.isValid) {
      window.location.href = '/login-mail';
      return;
    }

    let user: any = pb.authStore.model;

    try {
        const freshUser = await pb.collection('users').getOne(user.id);
        user = freshUser;
        
        // --- 🚀 DÉBUT DU SYSTÈME DE STREAK (FLAMME) ---
        const today = new Date().toISOString().split('T')[0]; // Récupère la date du jour (ex: "2026-06-03")
        let currentStreak = user.streak || 0;
        let lastVisit = user.last_visit || '';

        // Si l'utilisateur n'est pas encore venu aujourd'hui
        if (lastVisit !== today) {
          // On calcule la date d'hier
          const yesterday = new Date(Date.now() - 86400000).toISOString().split('T')[0];
          
          if (lastVisit === yesterday) {
            // S'il est venu hier, on incrémente la flamme
            currentStreak += 1;
          } else {
            // S'il a raté un jour (ou que c'est sa toute première visite), on réinitialise à 1
            currentStreak = 1;
          }

          // On met à jour PocketBase en tâche de fond avec la nouvelle flamme et la date d'aujourd'hui
          const updatedUser = await pb.collection('users').update(user.id, { 
            streak: currentStreak,
            last_visit: today
          });
          user = updatedUser; // On met à jour nos données locales avec la nouvelle flamme
        }
        // --- FIN DU SYSTÈME DE STREAK ---

        const authData = JSON.parse(localStorage.getItem('pocketbase_auth') || '{}');
        authData.model = user;
        localStorage.setItem('pocketbase_auth', JSON.stringify(authData));
    } catch (e) {
        console.error("Impossible de rafraîchir les données de l'utilisateur", e);
    }

    // Gestion de l'affichage du prénom
    const nameContainer = document.getElementById('name-display-container') as HTMLElement;
    const nameElement = document.getElementById('user-name') as HTMLElement;
    const editNameBtn = document.getElementById('edit-name-btn') as HTMLElement;
    const editNameForm = document.getElementById('edit-name-form') as HTMLElement;
    const nameInput = document.getElementById('name-input') as HTMLInputElement;
    const cancelNameBtn = document.getElementById('cancel-name-btn') as HTMLElement;

    if (nameElement) {
      nameElement.textContent = user.first_name || user.name || user.username || 'Utilisateur';
    }

    if (editNameBtn && editNameForm && nameContainer && cancelNameBtn && nameInput) {
      editNameBtn.addEventListener('click', () => {
        nameContainer.classList.add('hidden');
        editNameForm.classList.remove('hidden');
        editNameForm.style.display = 'flex';
        nameInput.value = user.first_name || user.name || user.username || '';
        nameInput.focus();
      });

      cancelNameBtn.addEventListener('click', () => {
        editNameForm.classList.add('hidden');
        editNameForm.style.display = 'none';
        nameContainer.classList.remove('hidden');
      });

      editNameForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const newName = nameInput.value.trim();
        if (!newName) return;
        try {
          const updatedUser = await pb.collection('users').update(user.id, { first_name: newName });
          user = updatedUser;
          nameElement.textContent = user.first_name || user.name || user.username;
          editNameForm.classList.add('hidden');
          nameContainer.classList.remove('hidden');
        } catch (error) {
          console.error("Erreur sauvegarde prénom:", error);
        }
      });
    }

    // Gestion de l'avatar
    const avatarPreview = document.getElementById('avatar-preview') as HTMLImageElement;
    const avatarDefault = document.getElementById('avatar-default') as HTMLElement;
    
    if (user.avatar && avatarPreview && avatarDefault) {
      avatarPreview.src = pb.files.getUrl(user, user.avatar);
      avatarPreview.classList.remove('hidden');
      avatarDefault.classList.add('hidden');
    }

    const container = document.getElementById('avatar-container') as HTMLElement;
    const input = document.getElementById('avatar-upload') as HTMLInputElement;
    
    if (container && input) {
      container.addEventListener('click', () => input.click());
      input.addEventListener('change', async (e: Event) => {
        const target = e.target as HTMLInputElement;
        const file = target.files?.[0];
        if (file) {
          const formData = new FormData();
          formData.append('avatar', file);
          try {
            await pb.collection('users').update(user.id, formData);
            window.location.reload(); 
          } catch (error) {
            console.error("Erreur upload:", error);
          }
        }
      });
    }

    // Affichage des données (XP, Flamme, Rang)
    const userXp = user.xp || 0; 
    
    const pcXp = document.getElementById('pc-xp') as HTMLElement;
    const mobXp = document.getElementById('mob-xp') as HTMLElement;
    
    if (pcXp) pcXp.textContent = userXp.toString();
    if (mobXp) mobXp.textContent = `${userXp} XP`;

    const currentLevelXp = userXp % 1000;
    const progressPercentage = Math.min((currentLevelXp / 1000) * 100, 100);
    const xpBar = document.getElementById('xp-bar') as HTMLElement;
    
    if (xpBar) {
        xpBar.style.width = `${progressPercentage}%`;
    }

    // On utilise la valeur streak qui a été calculée et mise à jour en début de script
    const userStreak = user.streak || 0;
    
    const pcStreak = document.getElementById('pc-streak') as HTMLElement;
    const mobStreak = document.getElementById('mob-streak') as HTMLElement;
    
    if (pcStreak) pcStreak.textContent = `${userStreak} Jours`;
    if (mobStreak) mobStreak.textContent = `${userStreak} Jours`;

    const pcRank = document.getElementById('pc-rank') as HTMLElement;
    const mobRank = document.getElementById('mob-rank') as HTMLElement;
    
    let rankName = "Apprenti";
    if (userXp >= 1000) rankName = "Initié";
    if (userXp >= 3000) rankName = "Explorateur";
    if (userXp >= 5000) rankName = "Expert";
    if (userXp >= 10000) rankName = "Maître";

    if (pcRank) pcRank.textContent = rankName;
    if (mobRank) mobRank.textContent = rankName;
  };

  loadProfileData();
  document.addEventListener('astro:page-load', loadProfileData);
</script>

<style>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    opacity: 0;
    animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .delay-100 { animation-delay: 100ms; }
  .delay-200 { animation-delay: 200ms; }
  .delay-300 { animation-delay: 300ms; }
</style>