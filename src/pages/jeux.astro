---
import Layout from '../layouts/Layout.astro';
import Header from '../components/SiteHeader.astro'; 
import Menu from '../components/Menu.astro';     
import Sidebar from '../components/Sidebar.astro'; 
import PocketBase from 'pocketbase';

const pb = new PocketBase('http://127.0.0.1:8090');

let categories: any[] = [];

try {
  const records = await pb.collection('categories').getFullList({
    sort: 'order', 
  });
  
  categories = records;
} catch (error) {
  console.error("Erreur récupération catégories PocketBase :", error);
}

const getCategoryIcon = (title: string) => {
  const t = title.toLowerCase();
  if (t.includes('alphabet')) return '/ABC.svg';
  if (t.includes('politesse')) return '/pouce politesse.svg';
  if (t.includes('urgence')) return '/urgence.svg';
  if (t.includes('sentiment') || t.includes('sensation') || t.includes('émotion')) return '/EMOJIS.svg';
  if (t.includes('temps') || t.includes('chiffre')) return '/TEMPS ET CHIFFRES.svg';
  if (t.includes('maison') || t.includes('lieu') || t.includes('quotidien')) return '/maison.svg';
  
  return null; 
};

const segmenter = new Intl.Segmenter('fr', { granularity: 'grapheme' });
const formatEmojis = (emojiString: string) => {
  if (!emojiString) return [];
  const cleanString = emojiString.replace(/\s+/g, '');
  return Array.from(segmenter.segment(cleanString)).map(s => s.segment);
};
---

<Layout title="Jeux | Kinezi">
  
  <Header />
  <Menu />
  <Sidebar />

  <main class="w-full min-h-screen bg-[#FFFFFF] md:pl-24 pb-24 px-6 relative flex flex-col items-center">
    
    <div class="w-full max-w-[900px] relative z-10 flex flex-col items-center pt-8 md:pt-12">
      
      <div class="text-center mb-12 w-full">
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-black text-gray-900 tracking-tight">
          Que veux-tu apprendre ?
        </h1>
        <p class="mt-3 text-gray-500 font-medium text-lg">Choisis un thème pour commencer à jouer.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8 w-full max-w-[850px]">
        
        {categories.length === 0 && (
          <p class="text-center text-gray-500 col-span-full py-10">Chargement des thèmes...</p>
        )}

        {categories.map((cat, index) => {
          const iconPath = getCategoryIcon(cat.title);
          
          // Logique de taille personnalisée
          let sizeClass = "w-28 h-28 md:w-36 md:h-36"; // Taille standard pour les autres
          if (iconPath === '/pouce politesse.svg') {
            sizeClass = "w-20 h-20 md:w-24 md:h-24"; // Reste petit
          } else if (iconPath === '/TEMPS ET CHIFFRES.svg') {
            sizeClass = "w-36 h-36 md:w-48 md:h-48"; // Encore plus grand pour Temps et Chiffres
          }
          
          return (
            <a 
              href={`/jeux/${cat.slug || cat.id}`} 
              class="group relative flex flex-col bg-white p-5 md:p-6 rounded-3xl border border-gray-100 shadow-[0_8px_30px_rgba(0,0,0,0.08)] transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_12px_32px_rgba(140,23,248,0.15)] hover:border-[#A898EE]/30 animate-slide-up"
              style={`animation-delay: ${index * 80}ms; opacity: 0; animation-fill-mode: forwards;`}
            >
              
              {/* Conteneur de l'icône : Suppression du fond et de l'arrondi (la cellule) */}
              <div class="w-full h-32 md:h-48 flex items-center justify-center mb-4 relative">
                
                {iconPath ? (
                  <img 
                    src={iconPath} 
                    alt={`Icône pour ${cat.title}`} 
                    class={`${sizeClass} object-contain transition-transform duration-500 group-hover:scale-110 drop-shadow-sm`} 
                  />
                ) : (
                  <span class="flex text-5xl md:text-6xl transition-transform duration-500 group-hover:scale-110">
                    {formatEmojis(cat.emoji).map((em) => (
                      <span class="inline-block">{em}</span>
                    ))}
                  </span>
                )}

              </div>

              <h2 class="text-gray-900 text-2xl md:text-3xl font-black text-center tracking-wide group-hover:text-[#8C17F8] transition-colors pb-2">
                {cat.title}
              </h2>
              
            </a>
          )
        })}
      </div>

    </div>
  </main>
</Layout>

<style>
  .animate-slide-up {
    animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
</style>