---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/SiteHeader.astro'; 
import Menu from '../../components/Menu.astro';     
import Sidebar from '../../components/Sidebar.astro'; 
import PocketBase from 'pocketbase';

// 1. Génération des routes dynamiques pour chaque leçon
export async function getStaticPaths() {
  try {
    const pb = new PocketBase('http://pbopensigne.lilian-maitre.fr');
    
    // On récupère toutes les leçons de PocketBase
    const lessons = await pb.collection('lessons').getFullList();
    
    // On crée une page pour chaque leçon (via son slug ou son id)
    return lessons.map((lesson) => ({
      params: { id: lesson.slug || lesson.id },
      props: { lesson },
    }));
  } catch (error) {
    console.error("Erreur lors de la récupération des leçons:", error);
    // Retourner un tableau vide en cas d'erreur pour permettre au build de continuer
    return [];
  }
}

// 2. Récupération de la leçon courante et initialisation du SDK PocketBase
const { lesson } = Astro.props;
const pb = new PocketBase('http://pbopensigne.lilian-maitre.fr');
---

<Layout title={`${lesson.title} | Dictionnaire Kinezi`}>
  
  <Header />
  <Menu />
  <Sidebar />

  <main class="min-h-[calc(100dvh)] bg-[#FFFFFF] md:pl-24 pt-6 md:pt-8 pb-12 px-6 relative flex flex-col items-center overflow-x-hidden">
    
    <div class="w-full max-w-[800px] relative z-10 flex flex-col items-center">
      
      <div class="w-full flex items-center justify-start mb-6 animate-fade-in">
        <button 
          onclick="history.back()" 
          class="mr-3 text-gray-400 hover:text-[#8C17F8] transition-colors cursor-pointer border-none bg-transparent"
        >
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>
        <h1 class="text-3xl md:text-4xl font-black text-gray-900 tracking-tight uppercase">
          {lesson.title}
        </h1>
      </div>

      <div class="w-full relative bg-black rounded-[2rem] overflow-hidden shadow-2xl aspect-video border-4 border-white group animate-slide-up">
        
        {lesson.video ? (
          // Si une vidéo est configurée sur PocketBase, on l'affiche :
          <video 
            src={pb.files.getUrl(lesson, lesson.video)} 
            controls 
            class="w-full h-full object-cover"
            preload="metadata"
          ></video>
        ) : (
          // S'il n'y a pas encore de vidéo :
          <div class="absolute inset-0 flex items-center justify-center bg-gray-900">
            <p class="text-white/50 font-medium italic">Vidéo en cours de préparation...</p>
          </div>
        )}
        
      </div>

      {/* Affichage d'une description ou de conseils si le champ existe dans PocketBase */}
      {lesson.description && (
        <div class="w-full mt-6 p-6 bg-gray-50 rounded-[1.5rem] border border-gray-100 animate-fade-in" style="animation-delay: 150ms;">
          <h2 class="text-lg font-bold text-gray-900 mb-2">Conseils pour réaliser le signe :</h2>
          <p class="text-gray-600 leading-relaxed">{lesson.description}</p>
        </div>
      )}

    </div>
  </main>
</Layout>

<style is:global>
  .animate-fade-in { 
    animation: fadeIn 0.6s ease-out forwards; 
  }
  .animate-slide-up { 
    animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; 
  }
  
  @keyframes fadeIn { 
    from { opacity: 0; } 
    to { opacity: 1; } 
  }
  @keyframes slideUp { 
    from { opacity: 0; transform: translateY(20px) scale(0.98); } 
    to { opacity: 1; transform: translateY(0) scale(1); } 
  }
</style>