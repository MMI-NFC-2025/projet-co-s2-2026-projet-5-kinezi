---
// src/pages/deconnexion.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Kinezi | Déconnexion...">
  <main class="h-screen w-full flex flex-col items-center justify-center bg-[#A898EE] text-white">
    <div class="animate-spin rounded-full h-12 w-12 border-4 border-white border-t-transparent mb-4"></div>
    <p class="text-xl font-bold">Déconnexion en cours...</p>
  </main>
</Layout>

<script>
  import { pb } from '../lib/pb.js';

  const logout = () => {
    pb.authStore.clear();

    setTimeout(() => {
      window.location.href = '/';
    }, 800);
  };

  logout();
  document.addEventListener('astro:page-load', logout);
</script>