---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/SiteHeader.astro'; 
import Menu from '../../../components/Menu.astro';     
import Sidebar from '../../../components/Sidebar.astro'; 
import { pb } from '../../../lib/pb.js';

export async function getStaticPaths() {
  const categories = await pb.collection('categories').getFullList();
  
  return categories.map((cat) => ({
    params: { id: cat.slug || cat.id },
    props: { category: cat },
  }));
}

const { category } = Astro.props;

const modes = [
  { name: "Imitation", slug: "imitation" },
  { name: "Memory", slug: "memory" },
  { name: "Swipe Signe", slug: "swipe-signe" },
  { name: "Speed Dactylo", slug: "speed-dactylo" }
];
---

<Layout title={`Mode de jeu - ${category.title} | Kinezi`}>
  
  <Header />
  <Menu />
  <Sidebar />

  <main class="min-h-[calc(100dvh)] bg-[#FFFFFF] md:pl-24 pt-6 md:pt-8 pb-12 px-6 relative flex flex-col items-center overflow-x-hidden">
    
    <div class="w-full max-w-[1000px] relative z-10 flex flex-col">
      
      <div class="w-full flex items-center justify-start mb-4 animate-fade-in">
        <button 
          onclick="history.back()" 
          class="mr-3 text-gray-400 hover:text-[#8C17F8] transition-colors cursor-pointer border-none bg-transparent"
        >
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>
        <h1 class="text-2xl md:text-3xl font-black text-gray-900 tracking-tight">
          {category.title}
        </h1>
      </div>

      <div class="text-center mb-6 animate-fade-in" style="animation-delay: 100ms; opacity: 0; animation-fill-mode: forwards;">
        <h2 class="text-3xl md:text-4xl font-black text-gray-900 leading-[1.2] tracking-tight">
          Choisissez votre<br/> mode de jeu
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 w-full max-w-[800px] mx-auto">
        
        {modes.map((mode, index) => {
          /* CORRECTION : L'URL est désormais uniforme et propre pour tous les modes */
          const hrefLink = `/jeux/${category.slug || category.id}/${mode.slug}`;

          return (
            <a 
              href={hrefLink}
              class="group flex flex-col items-center justify-center py-8 md:py-10 px-6 rounded-3xl bg-[#8C17F8] shadow-[0_8px_20px_rgba(140,23,248,0.2)] transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_12px_30px_rgba(140,23,248,0.4)] animate-slide-up relative overflow-hidden"
              style={`animation-delay: ${200 + (index * 100)}ms; opacity: 0; animation-fill-mode: forwards;`}
            >
              <div class="absolute inset-0 bg-white opacity-0 group-hover:opacity-10 transition-opacity duration-300"></div>
              
              <span class="text-white text-xl md:text-2xl font-bold tracking-wide text-center relative z-10">
                {mode.name}
              </span>
            </a>
          )
        })}

      </div>

    </div>
  </main>
</Layout>

<style>
  .animate-fade-in { animation: fadeIn 0.6s ease-out forwards; }
  .animate-slide-up { animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes slideUp { from { opacity: 0; transform: translateY(20px) scale(0.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
</style>