---
import Layout from '../layouts/Layout.astro';
import Header from '../components/SiteHeader.astro'; 
import Menu from '../components/Menu.astro';     
import Sidebar from '../components/Sidebar.astro';

---

<Layout title="Accueil | Kinezi">
  
  <Header />
  <Menu />
  <Sidebar />

  <main class="min-h-screen bg-white pb-24 relative overflow-x-hidden font-sans flex flex-col items-center">
    
    <div class="w-full max-w-[800px] relative z-10 p-6 md:p-10 pt-12 md:pt-16 animate-fade-in">
      
      {/* --- EN-TÊTE : PROFIL ET STREAK --- */}
      <div class="flex flex-col mb-10">
        <span class="text-gray-500 font-bold text-lg md:text-xl">Bon retour,</span>
        <h1 id="user-name" class="text-4xl md:text-5xl font-black text-gray-900 tracking-tight leading-none mb-3">
          Chargement...
        </h1>
        
        <div class="inline-flex items-center bg-orange-50 px-4 py-1.5 rounded-full w-fit shadow-sm border border-orange-100">
          <svg class="w-5 h-5 text-orange-500 mr-2" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.66 11.2c-.23-.3-.51-.56-.77-.82-.67-.6-1.43-1.03-2.07-1.66C13.33 7.26 13 4.85 13.95 3c-.95.23-1.78.75-2.49 1.32-2.59 2.08-3.61 5.75-2.39 8.9.04.1.08.2.08.33 0 .22-.15.42-.35.5-.22.1-.46.04-.56-.12-.11-.16-.17-.35-.22-.55-.22-1.03-.13-2.14.33-3.05-1.5 1.54-2.52 3.65-2.5 5.8 0 3.82 2.8 7.33 6.64 7.78 3.55.41 6.84-1.92 7.7-5.32.32-1.28.16-2.67-.53-3.8z"/>
          </svg>
          <span id="user-streak" class="font-black text-orange-600 tracking-wide">-- Jours</span>
        </div>
      </div>

      <div class="flex flex-col gap-5">

        <h2 class="text-2xl font-black text-gray-900 mt-6 mb-2 tracking-tight">Temps de pratique</h2>

        {/* 2. CARTE : IMITATION */}
        <a href="/jeux" class="bg-white border border-gray-100 rounded-[2rem] p-5 md:p-6 flex items-center justify-between shadow-md hover:shadow-xl hover:-translate-y-1 transition-all cursor-pointer">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 bg-[#F4F0FF] text-[#8C17F8] rounded-full flex items-center justify-center shrink-0">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            </div>
            <div>
              <h3 class="text-lg font-black text-gray-900">Imitation</h3>
              <p class="text-gray-500 font-bold text-sm">Face à l'IA</p>
            </div>
          </div>
          <div class="text-right">
            <span id="time-imitation" class="text-xl md:text-2xl font-black text-[#8C17F8]">0m</span>
          </div>
        </a>

        {/* 3. CARTE : DACTYLO */}
        <a href="/jeux" class="bg-white border border-gray-100 rounded-[2rem] p-5 md:p-6 flex items-center justify-between shadow-md hover:shadow-xl hover:-translate-y-1 transition-all cursor-pointer">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 bg-[#F4F0FF] text-[#8C17F8] rounded-full flex items-center justify-center shrink-0">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
            </div>
            <div>
              <h3 class="text-lg font-black text-gray-900">Dactylo</h3>
              <p class="text-gray-500 font-bold text-sm">Épellation LSF</p>
            </div>
          </div>
          <div class="text-right">
            <span id="time-dactylo" class="text-xl md:text-2xl font-black text-[#8C17F8]">0m</span>
          </div>
        </a>

        {/* 4. CARTE : SWIPE SIGNE */}
        <a href="/jeux" class="bg-white border border-gray-100 rounded-[2rem] p-5 md:p-6 flex items-center justify-between shadow-md hover:shadow-xl hover:-translate-y-1 transition-all cursor-pointer">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 bg-[#F4F0FF] text-[#8C17F8] rounded-full flex items-center justify-center shrink-0">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
            </div>
            <div>
              <h3 class="text-lg font-black text-gray-900">Swipe Signe</h3>
              <p class="text-gray-500 font-bold text-sm">Révision rapide</p>
            </div>
          </div>
          <div class="text-right">
            <span id="time-swipe" class="text-xl md:text-2xl font-black text-[#8C17F8]">0m</span>
          </div>
        </a>

        {/* 5. CARTE : MEMORY */}
        <a href="/jeux" class="bg-white border border-gray-100 rounded-[2rem] p-5 md:p-6 flex items-center justify-between shadow-md hover:shadow-xl hover:-translate-y-1 transition-all cursor-pointer">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 bg-[#F4F0FF] text-[#8C17F8] rounded-full flex items-center justify-center shrink-0">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"></path></svg>
            </div>
            <div>
              <h3 class="text-lg font-black text-gray-900">Memory</h3>
              <p class="text-gray-500 font-bold text-sm">Entraînement visuel</p>
            </div>
          </div>
          <div class="text-right">
            <span id="time-memory" class="text-xl md:text-2xl font-black text-[#8C17F8]">0m</span>
          </div>
        </a>

      </div>
    </div>
    
  </main>
</Layout>

<style is:global>
  .animate-fade-in { animation: fadeIn 0.6s ease-out forwards; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
</style>

<script>
  import { pb } from '../lib/pb.js';

  /** @param {number | string} totalSeconds */
  const formatTime = (totalSeconds) => {
    const secs = Number(totalSeconds);
    if (isNaN(secs) || secs < 60) return "< 1m";
    const hours = Math.floor(secs / 3600);
    const minutes = Math.floor((secs % 3600) / 60);
    if (hours > 0) return `${hours}h ${minutes}m`;
    return `${minutes}m`;
  };

  /** @param {any} users */
  const updateUIWithUserData = (users) => {
      const firstName = users.first_name || users.username || "Kinezien";
      
      const nameEl = document.getElementById('user-name');
      if (nameEl) nameEl.innerText = firstName;
      
      const streakEl = document.getElementById('user-streak');
      if (streakEl) streakEl.innerText = `${users.streak || 0} Jours`;
      
      const lastLessonLink = document.getElementById('link-last-lesson');
      if (lastLessonLink && users.last_lesson_url && users.last_lesson_url !== "N/A") {
         lastLessonLink.setAttribute('href', users.last_lesson_url);
      }

      const imitationEl = document.getElementById('time-imitation');
      if (imitationEl) imitationEl.innerText = formatTime(users.time_imitation);
      
      const dactyloEl = document.getElementById('time-dactylo');
      if (dactyloEl) dactyloEl.innerText = formatTime(users.time_dactylo);
      
      const swipeEl = document.getElementById('time-swipe');
      if (swipeEl) swipeEl.innerText = formatTime(users.time_swipe);
      
      const memoryEl = document.getElementById('time-memory');
      if (memoryEl) memoryEl.innerText = formatTime(users.time_memory);
  };

  const initDashboard = async () => {
    
    console.log("Statut de connexion PocketBase :", pb.authStore.isValid);

    if (!pb.authStore.isValid) {
        const localAuth = JSON.parse(localStorage.getItem('pocketbase_auth') || '{}');
        if (localAuth.token && localAuth.model) {
            pb.authStore.save(localAuth.token, localAuth.model);
        }
    }

    const cachedUser = pb.authStore.model;
    
    if (cachedUser) {
      console.log("Utilisateur trouvé :", cachedUser.username);
      updateUIWithUserData(cachedUser);

      try {
        const freshUser = await pb.collection('users').getOne(cachedUser.id);
        updateUIWithUserData(freshUser);
        
        pb.authStore.save(pb.authStore.token, freshUser);
        const authData = JSON.parse(localStorage.getItem('pocketbase_auth') || '{}');
        authData.model = freshUser;
        localStorage.setItem('pocketbase_auth', JSON.stringify(authData));
        
      } catch (error) {
        console.error("Impossible de récupérer les données fraîches :", error);
      }

    } else {
      console.warn("Tu n'es pas connecté ! Les données resteront vides.");
      const nameEl = document.getElementById('user-name');
      if (nameEl) nameEl.innerText = "Invité (Connecte-toi !)";
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDashboard);
  } else {
    initDashboard();
  }
  document.addEventListener('astro:page-load', initDashboard);
</script>