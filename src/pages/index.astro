---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Kinezi | Brisez le silence, apprenez à signer.">
    <Header />
    <Menu />

    <main class="relative min-h-[90vh] bg-white pt-[180px] pb-8 overflow-hidden">
    <div class="absolute inset-0 z-0 opacity-[0.08]" style="background-image: radial-gradient(#8C17F8 1px, transparent 1px); background-size: 32px 32px;"></div>
    <div class="absolute top-1/4 -right-20 w-[600px] h-[600px] bg-[#8C17F8]/3 rounded-full blur-[120px] pointer-events-none z-0"></div>
    <div class="absolute -top-32 -left-32 w-[500px] h-[500px] bg-[#8C17F8]/3 rounded-full blur-[120px] pointer-events-none z-0"></div>

    <div class="max-w-[1300px] mx-auto px-8 lg:px-16 flex flex-col md:flex-row md:items-end justify-between gap-12 lg:gap-20 relative z-10">
        
        <div class="flex-1 text-center md:text-left flex flex-col items-center md:items-start animate-fade-in pb-4 md:pb-20 order-1">
            <h1 class="text-4xl md:text-5xl lg:text-[4rem] font-bold leading-tight text-gray-900">
                <span class="inline-block whitespace-nowrap">Brisez le silence,</span><br />
                <span class="inline-block whitespace-nowrap text-[#8C17F8]">apprenez à signer.</span>
            </h1>
            
            <a id="hero-btn" href="#discover" class="hidden md:inline-block mt-10 bg-gradient-to-br from-[#8C17F8] to-[#7a14da] text-white font-bold text-3xl md:text-4xl px-12 py-6 rounded-full shadow-[0_10px_25px_rgba(140,23,248,0.25)] hover:shadow-[0_15px_35px_rgba(140,23,248,0.35)] transition-all transform hover:-translate-y-1 active:scale-95 text-center">
                Découvrez nous !
            </a>
        </div>

        <div class="flex-1 flex justify-center z-0 w-full md:-translate-x-12 pb-0 md:pb-4 order-2">
            <div class="relative w-full max-w-[340px] flex flex-col items-center">
                <img src="/mockup-telephone.png" alt="Interface Kinezi" class="w-full h-auto object-contain pointer-events-none animate-float relative z-10 mb-4 md:mb-8" />
                <div class="absolute bottom-[0px] w-[80%] h-12 bg-black/15 rounded-[100%] blur-[18px] animate-shadow-pulse z-0"></div>
                <div class="absolute bottom-[5px] w-[55%] h-4 bg-black/35 rounded-[100%] blur-[6px] animate-shadow-pulse z-0"></div>
            </div>
        </div>

        <div class="w-full flex justify-center md:hidden order-3 pb-6 -mt-4">
            <a id="mobile-hero-btn" href="#discover" class="inline-block bg-gradient-to-br from-[#8C17F8] to-[#7a14da] text-white font-bold text-xl px-10 py-4 rounded-full shadow-[0_10px_25px_rgba(140,23,248,0.25)] active:scale-95 text-center">
                Découvrez nous !
            </a>
        </div>

    </div>
</main>

    <section id="discover" class="pt-12 pb-24 bg-white relative z-10 border-b border-gray-100">
        </section>

    <section class="pb-40 bg-white relative z-10">
        <div class="max-w-[1300px] mx-auto px-8 lg:px-16 text-center">
            <h2 id="join-title" class="text-4xl md:text-5xl font-black text-gray-900 mb-10 tracking-tight">
                Rejoignez nous !
            </h2>
            <a id="join-btn" href="/register" class="inline-block bg-[#8C17F8] text-white font-black text-2xl md:text-3xl px-16 py-6 rounded-full shadow-[0_15px_35px_rgba(140,23,248,0.3)] hover:shadow-[0_20px_45px_rgba(140,23,248,0.4)] transition-all transform hover:-translate-y-1 active:scale-95 animate-pulse-subtle">
                Je rejoins !
            </a>
        </div>
    </section>

    <Footer />
</Layout>

<script>
    import PocketBase from 'pocketbase';

    const checkAuthStatus = () => {
        const pb = new PocketBase('http://127.0.0.1:8090');
        
        // Si l'utilisateur est connecté
        if (pb.authStore.isValid) {
            const user = pb.authStore.model;
            
            // 1. Bouton Hero (PC)
            const heroBtn = document.getElementById('hero-btn');
            if (heroBtn) {
                heroBtn.textContent = "Mon Profil";
                heroBtn.setAttribute('href', '/profil');
            }

            // 2. Bouton Hero (Mobile)
            const mobileHeroBtn = document.getElementById('mobile-hero-btn');
            if (mobileHeroBtn) {
                mobileHeroBtn.textContent = "Mon Profil";
                mobileHeroBtn.setAttribute('href', '/profil');
            }

            // 3. Section du bas "Rejoignez-nous"
            const joinBtn = document.getElementById('join-btn');
            const joinTitle = document.getElementById('join-title');
            if (joinBtn && joinTitle) {
                joinTitle.textContent = `Ravi de vous revoir, ${user.first_name} !`;
                joinBtn.textContent = "Accéder à l'appli";
                joinBtn.setAttribute('href', '/profil');
            }
        }
    };

    // On lance la vérification
    checkAuthStatus();
    // Support pour les transitions de pages Astro (View Transitions)
    document.addEventListener('astro:page-load', checkAuthStatus);
</script>

<style>
    /* ... Tes styles d'animations (float, shadowPulse, etc.) ... */
</style>