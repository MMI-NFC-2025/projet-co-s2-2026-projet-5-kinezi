---
import Layout from '../layouts/Layout.astro';
import Header from '../components/SiteHeader.astro'; 
import Menu from '../components/Menu.astro';     
import Sidebar from '../components/Sidebar.astro'; 
import PocketBase from 'pocketbase';

const pb = new PocketBase('http://127.0.0.1:8090');

let leaderboard: any[] = [];

try {
  // Changement ici : On trie par '-xp' pour avoir les meilleurs scores en premier
  const records = await pb.collection('users').getList(1, 50, {
    sort: '-xp', 
  });
  
  leaderboard = records.items.map((user, index) => ({
    id: user.id,
    rank: index + 1,
    name: user.first_name || user.username || user.name || 'Utilisateur',
    xp: user.xp || 0, // Récupération de l'XP
    avatar: user.avatar ? pb.files.getUrl(user, user.avatar) : null
  }));

} catch (error) {
  console.error("Erreur récupération classement :", error);
}

const getMedalStyles = (rank: number) => {
  if (rank === 1) return { text: 'text-[#B48608]', bg: 'bg-[#FEF08A]/50' }; // Or
  if (rank === 2) return { text: 'text-[#64748B]', bg: 'bg-gray-200' };     // Argent
  if (rank === 3) return { text: 'text-[#92400E]', bg: 'bg-[#FED7AA]/60' }; // Bronze
  return { text: 'text-gray-500', bg: 'bg-gray-100' }; // Autres
};
---

<Layout title="Classement | Kinezi">
  
  <Header />
  <Menu />
  <Sidebar />

  <main class="min-h-screen bg-[#FFFFFF] md:ml-20 pt-6 md:pt-8 pb-24 px-6 md:px-12 relative overflow-hidden">
    
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-[#A898EE]/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3 pointer-events-none"></div>

    <div class="max-w-[1000px] mx-auto relative z-10">
      
      <div class="text-center mb-12 animate-fade-in">
        <h1 class="text-4xl md:text-5xl font-black text-gray-900 tracking-tight">
          Classement
        </h1>
        <p class="mt-4 text-gray-600 font-medium text-lg">Découvre les meilleurs joueurs de Kinezi.</p>
      </div>

      <div class="flex flex-col gap-4 max-w-[650px] mx-auto">
        
        {leaderboard.length === 0 && (
          <p class="text-center text-gray-500 py-10">Aucun joueur trouvé.</p>
        )}

        {leaderboard.map((user, index) => {
          const medal = getMedalStyles(user.rank);
          
          return (
            <div 
              data-user-row={user.id} 
              class="user-row flex items-center gap-4 md:gap-6 px-4 md:px-6 py-4 rounded-[2rem] transition-all duration-300 hover:-translate-y-2 bg-white border border-gray-100 shadow-[0_8px_30px_rgba(0,0,0,0.12)] text-gray-800 hover:shadow-[0_12px_32px_rgba(140,23,248,0.18)] animate-slide-up"
              style={`animation-delay: ${index * 80}ms; opacity: 0; animation-fill-mode: forwards;`}
            >
              
              <div class={`w-12 h-12 md:w-14 md:h-14 rounded-full shrink-0 flex justify-center items-center text-xl font-black ${medal.bg} transition-colors`}>
                {user.rank <= 3 ? (
                  <svg class={`medal-svg w-7 h-7 md:w-8 md:h-8 ${medal.text}`} viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 15c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm0-4c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1zm6.5-5.5l-2.5 7.5c-.38 1.14-1.42 2-2.67 2h-2.66c-1.25 0-2.29-.86-2.67-2L5.5 5.5c-.28-.85.44-1.63 1.3-1.47l4.08.76L12 2l1.12 2.79 4.08-.76c.86-.16 1.58.62 1.3 1.47z"/>
                  </svg>
                ) : (
                  <span class={medal.text}>{user.rank}</span>
                )}
              </div>

              <div class="avatar-border w-12 h-12 md:w-14 md:h-14 flex-shrink-0 rounded-full border-[3px] border-gray-100 bg-gray-50 text-gray-400 flex items-center justify-center overflow-hidden transition-colors">
                {user.avatar ? (
                  <img src={user.avatar} alt="Avatar" class="w-full h-full object-cover" />
                ) : (
                  <svg class="w-6 h-6 md:w-7 md:h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <circle cx="12" cy="8" r="4"></circle>
                    <path d="M6 21v-2a4 4 0 014-4h4a4 4 0 014 4v2"></path>
                  </svg>
                )}
              </div>

              <div class="flex-1 min-w-0">
                <div class="user-name text-lg md:text-xl font-bold tracking-wide transition-colors truncate">
                  {user.name}
                </div>
              </div>

              {/* NOUVEAU : Affichage de l'XP */}
              <div class="xp-badge flex items-center gap-1.5 bg-[#FFF8E7] border border-[#FFE8A1] px-3 py-1.5 md:px-4 md:py-2 rounded-xl shrink-0 transition-colors">
                <span class="text-[#F59E0B] font-black text-sm md:text-lg">{user.xp}</span>
                <span class="text-[#D4A017] font-bold text-xs md:text-sm">XP</span>
              </div>

            </div>
          )
        })}
      </div>

    </div>
  </main>
</Layout>

<style>
  .animate-fade-in {
    animation: fadeIn 0.8s ease-out forwards;
  }
  
  .animate-slide-up {
    animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
</style>

<script>
  import PocketBase from 'pocketbase';

  const highlightMe = () => {
    const pb = new PocketBase('http://127.0.0.1:8090');
    
    if (pb.authStore.isValid && pb.authStore.model) {
      const myId = pb.authStore.model.id;
      const myRow = document.querySelector(`[data-user-row="${myId}"]`);
      
      if (myRow) {
        
        // La ligne active garde son superbe design violet
        myRow.className = "user-row flex items-center gap-4 md:gap-6 px-4 md:px-6 py-4 rounded-[2rem] transition-all duration-300 bg-gradient-to-r from-[#8C17F8] to-[#A898EE] text-white shadow-[0_10px_30px_-10px_rgba(140,23,248,0.6)] border border-transparent scale-[1.02] relative z-20 hover:-translate-y-1 hover:shadow-[0_15px_40px_-10px_rgba(140,23,248,0.7)] animate-slide-up";
        
        const avatarBorder = myRow.querySelector('.avatar-border');
        if (avatarBorder) {
          avatarBorder.classList.remove('border-gray-100', 'bg-gray-50', 'text-gray-400');
          avatarBorder.classList.add('border-white/80', 'bg-white/20', 'text-white');
        }

        const medalContainer = myRow.querySelector('.rounded-full.shrink-0');
        const medalSvg = myRow.querySelector('.medal-svg');
        const rankText = myRow.querySelector('span[class*="text-"]');

        if (medalContainer) {
           medalContainer.className = medalContainer.className.replace(/bg-\[#.*?\]\/\d+|bg-gray-\d+/g, 'bg-white/20');
        }
        if (medalSvg) {
           medalSvg.className = medalSvg.className.replace(/text-\[#.*?\]/g, 'text-white drop-shadow-md');
        }
        if (rankText) {
           rankText.className = "text-white font-black drop-shadow-sm";
        }

        // Coloration de l'XP pour l'utilisateur connecté
        const xpBadge = myRow.querySelector('.xp-badge');
        if (xpBadge) {
          xpBadge.className = xpBadge.className.replace(/bg-\[.*?\]|border-\[.*?\]/g, '');
          xpBadge.classList.add('bg-white/20', 'border-white/30');
          const xpSpans = xpBadge.querySelectorAll('span');
          xpSpans.forEach(span => {
            span.className = span.className.replace(/text-\[.*?\]/g, 'text-white drop-shadow-sm');
          });
        }
      }
    }
  };

  highlightMe();
  document.addEventListener('astro:page-load', highlightMe);
</script>