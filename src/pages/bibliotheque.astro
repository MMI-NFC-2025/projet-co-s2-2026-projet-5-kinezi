---
import Layout from '../layouts/Layout.astro';
import Header from '../components/SiteHeader.astro'; 
import Menu from '../components/Menu.astro';     
import Sidebar from '../components/Sidebar.astro'; 
import PocketBase from 'pocketbase';

const pb = new PocketBase('http://127.0.0.1:8090');

let lessons: any[] = [];
try {
  // On récupère les leçons pour la bibliothèque
  lessons = await pb.collection('lessons').getFullList({
    sort: 'category,order',
  });
} catch (error) {
  console.error("Erreur PocketBase :", error);
}

const groupedLessons = lessons.reduce((acc: any, lesson) => {
  if (!acc[lesson.category]) acc[lesson.category] = [];
  acc[lesson.category].push(lesson);
  return acc;
}, {});
---

<Layout title="Bibliothèque | Kinezi">
  <Header />
  <Menu />
  <Sidebar />

  <main class="min-h-screen bg-[#F8F9FA] md:ml-20 pt-32 pb-24 px-6 md:px-12">
    <div class="max-w-[1100px] mx-auto">
      
      <div class="text-center mb-20">
        <h1 class="text-4xl md:text-5xl font-black text-gray-900 leading-[1.1] tracking-tight">
          Bibliothèque<br/>
          <span class="text-[#A898EE]">de leçons</span>
        </h1>
      </div>

      {Object.entries(groupedLessons).map(([categoryName, categoryLessons]) => (
        <section class="mb-16">
          <h2 class="text-2xl font-black text-gray-900 mb-8">{categoryName}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {/* @ts-ignore */}
            {categoryLessons.map((lesson) => (
              <div class="group relative bg-white rounded-3xl p-4 shadow-sm border border-gray-100 transition-all hover:-translate-y-2">
                
                <div class="w-full aspect-square bg-[#A898EE]/5 rounded-2xl flex items-center justify-center mb-5 relative overflow-hidden">
                  <a href={`/lecon/${lesson.id}`} class="absolute inset-0 z-10"></a>
                  
                  <button 
                    data-id={lesson.id} 
                    class="lib-like-btn absolute top-3 right-3 z-30 w-10 h-10 bg-white rounded-full flex items-center justify-center text-gray-300 hover:text-[#8C17F8] hover:scale-110 transition-all shadow-md"
                  >
                    <svg class="w-6 h-6 pointer-events-none fill-none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
                    </svg>
                  </button>

                  <span class="text-5xl">{lesson.emoji || '📖'}</span>
                </div>

                <h3 class="text-xl font-black text-gray-900 px-2">{lesson.title}</h3>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
</Layout>

<script>
  import PocketBase from 'pocketbase';

  const start = async () => {
    const pb = new PocketBase('http://127.0.0.1:8090');
    
    // On vérifie si l'utilisateur est connecté
    if (!pb.authStore.isValid || !pb.authStore.model) return;
    
    const userId = pb.authStore.model.id;
    const btns = document.querySelectorAll('.lib-like-btn');

    try {
      // 1. On charge les favoris depuis la base de données
      const favs = await pb.collection('favorites').getFullList({ 
        filter: `user="${userId}"`,
        $autoCancel: false // Évite que PocketBase annule la requête
      });
      
      const favMap = new Map();
      favs.forEach(f => favMap.set(f.lecon, f.id));

      btns.forEach(btn => {
        const lessonId = btn.getAttribute('data-id');
        const svg = btn.querySelector('svg');
        if (!lessonId || !svg) return;

        // 2. ÉTAT INITIAL : Si la leçon est dans les favoris, on colore le cœur
        if (favMap.has(lessonId)) {
          btn.setAttribute('data-fav-id', favMap.get(lessonId));
          btn.classList.remove('text-gray-300');
          btn.classList.add('text-[#8C17F8]');
          svg.classList.add('fill-current');
          svg.classList.remove('fill-none');
        } else {
          // Sécurité : on remet en gris si ce n'est pas un favori
          btn.removeAttribute('data-fav-id');
          btn.classList.add('text-gray-300');
          btn.classList.remove('text-[#8C17F8]');
          svg.classList.remove('fill-current');
          svg.classList.add('fill-none');
        }

        // 3. GESTION DU CLIC (Supprimé les anciens écouteurs pour éviter les doublons)
        btn.replaceWith(btn.cloneNode(true));
        const newBtn = document.querySelector(`[data-id="${lessonId}"]`);
        
        newBtn?.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          
          const currentFavId = newBtn.getAttribute('data-fav-id');
          const currentSvg = newBtn.querySelector('svg');

          if (currentFavId) {
            // UNLIKE
            newBtn.removeAttribute('data-fav-id');
            newBtn.classList.remove('text-[#8C17F8]');
            newBtn.classList.add('text-gray-300');
            currentSvg?.classList.remove('fill-current');
            currentSvg?.classList.add('fill-none');
            await pb.collection('favorites').delete(currentFavId);
          } else {
            // LIKE
            newBtn.classList.add('text-[#8C17F8]');
            newBtn.classList.remove('text-gray-300');
            currentSvg?.classList.add('fill-current');
            currentSvg?.classList.remove('fill-none');

            const res = await pb.collection('favorites').create({ 
              user: userId, 
              lecon: lessonId
            });
            newBtn.setAttribute('data-fav-id', res.id);
          }
        });
      });
    } catch (err) {
      console.error("Erreur chargement favoris bibliothèque:", err);
    }
  };

  // --- LA CORRECTION POUR ASTRO ---
  // On lance au premier chargement
  start();
  // On relance à chaque changement de page Astro
  document.addEventListener('astro:page-load', start);
</script>